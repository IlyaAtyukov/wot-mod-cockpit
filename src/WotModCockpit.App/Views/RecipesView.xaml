<UserControl x:Class="WotModCockpit.App.Views.RecipesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WotModCockpit.App.Controls"
             xmlns:conv="clr-namespace:WotModCockpit.App.Converters"
             xmlns:vm="clr-namespace:WotModCockpit.App.ViewModels"
             Background="{StaticResource Brush.Window}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:StringToVisibilityConverter x:Key="StrToVis" />
        <conv:CountToVisibilityConverter x:Key="CountToVis" />

        <!-- Строка каталога. Пометка «требует проверки» появляется только там, где сверка
             с индексом ДЕЙСТВИТЕЛЬНО что-то не нашла: «не проверяли» и «нет в клиенте» —
             разные вещи, и путать их нельзя. -->
        <DataTemplate x:Key="RecipeTemplate" DataType="{x:Type vm:RecipeItemViewModel}">
            <Grid Margin="6,3" ToolTip="{Binding ToolTipText}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding Id}"
                           MinWidth="30"
                           Margin="0,0,6,0"
                           VerticalAlignment="Top"
                           FontFamily="{StaticResource Font.Mono}"
                           FontSize="11"
                           Foreground="{StaticResource Brush.TextMuted}" />

                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="Title"
                               Text="{Binding Title}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource Brush.Text}" />
                    <TextBlock Text="{Binding Summary}"
                               FontSize="10"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource Brush.TextMuted}" />
                    <TextBlock Text="{Binding CompatibilityText}"
                               FontSize="10"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource Brush.WarnText}"
                               Visibility="{Binding HasCompatibilityNote, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="{Binding LevelBadge}"
                           Margin="8,0,0,0"
                           VerticalAlignment="Top"
                           FontSize="10"
                           Foreground="{StaticResource Brush.TextMuted}" />
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsIncompatible}" Value="True">
                    <Setter TargetName="Title" Property="Foreground" Value="{StaticResource Brush.WarnText}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Поле подстановки. Паспортные поля помечены: их значение приехало из открытого
             проекта, и менять его руками обычно не надо. -->
        <DataTemplate x:Key="ParameterTemplate" DataType="{x:Type vm:RecipeParamViewModel}">
            <StackPanel Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Label}" Style="{StaticResource Style.FieldLabel}" />
                    <TextBlock Text="из проекта"
                               Margin="6,0,0,0"
                               FontSize="9"
                               Foreground="{StaticResource Brush.OkText}"
                               Visibility="{Binding FromProject, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="{StaticResource Font.Mono}"
                         FontSize="11" />

                <TextBlock Margin="0,2,0,0"
                           FontSize="9"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource Brush.TextMuted}">
                    <Run Text="заменяет" />
                    <Run Text="{Binding Pattern, Mode=OneWay}" FontFamily="{StaticResource Font.Mono}" />
                    <Run Text=" · " />
                    <Run Text="{Binding Hint, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="Style.CategoryHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            <Setter Property="Margin" Value="6,8,0,2" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!-- Выпадающий список в тёмной теме. Единственный ComboBox во всём кокпите, поэтому
             стиль живёт здесь, а не в общем словаре: класть в Styles/DarkTheme.xaml правило
             ради одного экрана — значит менять вид всего приложения ради одного экрана. -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF2D3D4B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            <Setter Property="Background" Value="#FF17171A" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="MaxDropDownHeight" Value="320" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd"
                                                Background="#FF17171A"
                                                BorderBrush="{StaticResource Brush.Border}"
                                                BorderThickness="1"
                                                CornerRadius="3">
                                            <Path x:Name="Arrow"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,7,0"
                                                  Data="M0,0 L8,0 L4,5 Z"
                                                  Fill="{StaticResource Brush.TextMuted}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF4C4C55" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter Margin="7,0,20,0"
                                              IsHitTestVisible="False"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{StaticResource Brush.PanelAlt}"
                                        BorderBrush="{StaticResource Brush.Border}"
                                        BorderThickness="1">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="220" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="330" MinWidth="220" />
            </Grid.ColumnDefinitions>

            <!-- ================== ЛЕВО: каталог ================== -->
            <Grid Grid.Column="0" Background="{StaticResource Brush.Panel}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="0,0,0,1"
                        Padding="6,5">
                    <StackPanel>
                        <Grid>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{StaticResource Font.Mono}" />
                            <TextBlock Text="поиск: лог, хоткей, монкипатч…"
                                       Margin="8,0,0,0"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="{StaticResource Brush.TextMuted}"
                                       Visibility="{Binding SearchText, Converter={StaticResource StrToVis}, ConverterParameter=invert}" />
                        </Grid>

                        <WrapPanel Margin="0,5,0,0">
                            <ToggleButton Style="{StaticResource Style.Chip}"
                                          Content="только для новичка"
                                          IsChecked="{Binding OnlyBeginner}" />
                            <TextBlock Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource Style.Muted}"
                                       Text="{Binding CatalogStatus}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1">
                    <ListBox x:Name="RecipeList"
                             ItemsSource="{Binding Recipes}"
                             SelectedItem="{Binding Selected}"
                             ItemTemplate="{StaticResource RecipeTemplate}"
                             HorizontalContentAlignment="Stretch"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource Style.CategoryHeader}">
                                            <Run Text="{Binding Name, Mode=OneWay}" />
                                            <Run Text="{Binding ItemCount, Mode=OneWay, StringFormat=' ({0})'}"
                                                 FontWeight="Normal"
                                                 Foreground="{StaticResource Brush.TextMuted}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                    </ListBox>

                    <TextBlock Style="{StaticResource Style.EmptyState}"
                               FontSize="12"
                               Text="{Binding EmptyStateText}"
                               Visibility="{Binding Recipes.Count, Converter={StaticResource CountToVis}, ConverterParameter=invert}" />
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

            <!-- ================== ЦЕНТР: карточка и код ================== -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Style.Card}">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedTitle}"
                                   FontSize="14"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource Brush.Text}" />

                        <TextBlock Text="{Binding Rationale}"
                                   Margin="0,4,0,0"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource Brush.Text}"
                                   Visibility="{Binding Rationale, Converter={StaticResource StrToVis}}" />

                        <!-- «Где ломается» — самая ценная часть карточки: рецепты написаны
                             так, что без этого абзаца их можно скопировать и получить мод,
                             который молча не работает. -->
                        <Border Margin="0,6,0,0"
                                Padding="8,5"
                                CornerRadius="3"
                                Background="{StaticResource Brush.WarnBg}"
                                BorderBrush="#FF5C5030"
                                BorderThickness="1"
                                Visibility="{Binding Pitfall, Converter={StaticResource StrToVis}}">
                            <StackPanel>
                                <TextBlock Text="ГДЕ ЛОМАЕТСЯ"
                                           FontSize="10"
                                           Margin="0,0,0,2"
                                           Foreground="{StaticResource Brush.TextMuted}" />
                                <TextBlock Text="{Binding Pitfall}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource Brush.WarnText}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding CompatibilityText}"
                                   Margin="0,6,0,0"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource Brush.DangerText}"
                                   Visibility="{Binding CompatibilityText, Converter={StaticResource StrToVis}}" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1">
                    <controls:PythonSourceView SourceText="{Binding RenderedCode}"
                                               EmptyText="Выберите рецепт слева." />

                    <TextBlock Style="{StaticResource Style.EmptyState}"
                               FontSize="12"
                               IsHitTestVisible="False"
                               Text="Выберите рецепт слева.&#10;&#10;Здесь появится его код на Python 2.7 — уже с подставленными&#10;идентификатором, пакетом и тегом лога вашего проекта."
                               Visibility="{Binding HasCode, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

            <!-- ================== ПРАВО: параметры и вставка ================== -->
            <Grid Grid.Column="4" Background="{StaticResource Brush.Panel}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="8,6">
                    <StackPanel>
                        <TextBlock Text="ПАРАМЕТРЫ ПОДСТАНОВКИ" Style="{StaticResource Style.FieldLabel}" />
                        <TextBlock Style="{StaticResource Style.Muted}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"
                                   Text="Предпросмотр слева обновляется на каждое нажатие клавиши." />

                        <ItemsControl ItemsSource="{Binding Parameters}"
                                      ItemTemplate="{StaticResource ParameterTemplate}" />

                        <TextBlock Style="{StaticResource Style.Muted}"
                                   TextWrapping="Wrap"
                                   Text="У этого рецепта нет полей подстановки."
                                   Visibility="{Binding Parameters.Count, Converter={StaticResource CountToVis}, ConverterParameter=invert}" />

                        <Button Style="{StaticResource Style.SmallButton}"
                                HorizontalAlignment="Left"
                                Margin="0,4,0,0"
                                Content="вернуть значения проекта"
                                Command="{Binding ResetParametersCommand}"
                                Visibility="{Binding Parameters.Count, Converter={StaticResource CountToVis}}" />

                        <TextBlock Text="СИМВОЛЫ КЛИЕНТА"
                                   Margin="0,14,0,2"
                                   Style="{StaticResource Style.FieldLabel}"
                                   Visibility="{Binding SymbolsText, Converter={StaticResource StrToVis}}" />
                        <TextBlock Text="{Binding SymbolsText}"
                                   FontFamily="{StaticResource Font.Mono}"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource Brush.TextMuted}"
                                   Visibility="{Binding SymbolsText, Converter={StaticResource StrToVis}}" />
                        <Button Style="{StaticResource Style.SmallButton}"
                                HorizontalAlignment="Left"
                                Margin="0,4,0,0"
                                Content="показать в браузере API"
                                Command="{Binding ShowSymbolCommand}"
                                ToolTip="Открыть в браузере API объявление символа, на котором держится рецепт"
                                Visibility="{Binding SymbolsText, Converter={StaticResource StrToVis}}" />
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="1"
                        Background="{StaticResource Brush.PanelAlt}"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="0,1,0,0"
                        Padding="8,6">
                    <StackPanel>
                        <TextBlock Text="КУДА ВСТАВИТЬ" Style="{StaticResource Style.FieldLabel}" />

                        <ComboBox ItemsSource="{Binding TargetFiles}"
                                  SelectedItem="{Binding SelectedTargetFile}"
                                  FontFamily="{StaticResource Font.Mono}"
                                  FontSize="11"
                                  IsEnabled="{Binding HasProject}" />

                        <TextBlock Text="{Binding InsertHint}"
                                   Style="{StaticResource Style.Muted}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0" />

                        <WrapPanel Margin="0,8,0,0">
                            <Button Style="{StaticResource Style.SmallButton}"
                                    Margin="0,0,6,0"
                                    Content="копировать"
                                    Command="{Binding CopyCodeCommand}" />
                            <Button Style="{StaticResource Style.WriteButton}"
                                    Padding="8,3"
                                    FontSize="11"
                                    MinWidth="0"
                                    Content="вставить в файл…"
                                    Command="{Binding InsertIntoFileCommand}"
                                    ToolTip="Дописать рецепт в конец выбранного файла. Сначала покажет, что именно будет добавлено, и оставит рядом копию .bak." />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ==================== СТРОКА СОСТОЯНИЯ ==================== -->
        <Border Grid.Row="1"
                Background="{StaticResource Brush.Panel}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,1,0,0"
                Padding="10,4">
            <TextBlock Style="{StaticResource Style.Muted}"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding StatusText}"
                       ToolTip="{Binding StatusText}" />
        </Border>
    </Grid>
</UserControl>
