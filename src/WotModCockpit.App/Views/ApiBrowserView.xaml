<UserControl x:Class="WotModCockpit.App.Views.ApiBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:api="clr-namespace:WotModCockpit.App.ApiBrowser"
             xmlns:controls="clr-namespace:WotModCockpit.App.Controls"
             xmlns:conv="clr-namespace:WotModCockpit.App.Converters"
             xmlns:vm="clr-namespace:WotModCockpit.App.ViewModels"
             Background="{StaticResource Brush.Window}">

    <UserControl.Resources>

        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:StringToVisibilityConverter x:Key="StrToVis" />
        <conv:CountToVisibilityConverter x:Key="CountToVis" />
        <conv:EnumToBooleanConverter x:Key="EnumToBool" />
        <conv:EnumToVisibilityConverter x:Key="EnumToVis" />
        <conv:SymbolKindToBrushConverter x:Key="KindToBrush" />
        <conv:XrefKindToBrushConverter x:Key="XrefKindToBrush" />
        <conv:TierToOpacityConverter x:Key="TierToOpacity" />

        <!-- Значок вида символа. Три буквы вместо иконки: значков нужно восемь видов,
             а читаются они в списке из 200 строк одинаково быстро. -->
        <Style x:Key="Style.KindBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="#FF232327" />
            <Setter Property="BorderBrush" Value="#FF3A3A41" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Margin" Value="0,1,6,1" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="MinWidth" Value="32" />
        </Style>

        <!-- ===================== символ в выдаче поиска ===================== -->
        <DataTemplate x:Key="SymbolTemplate" DataType="{x:Type vm:SymbolViewModel}">
            <Grid Margin="6,3" Opacity="{Binding Symbol.Tier, Converter={StaticResource TierToOpacity}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Style.KindBadge}">
                    <TextBlock Text="{Binding KindBadge}"
                               FontFamily="{StaticResource Font.Mono}"
                               FontSize="10"
                               TextAlignment="Center"
                               Foreground="{Binding Symbol.Kind, Converter={StaticResource KindToBrush}}" />
                </Border>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Header}"
                               ToolTip="{Binding ToolTipText}"
                               FontFamily="{StaticResource Font.Mono}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource Brush.Text}" />

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Location}"
                                   FontSize="10"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource Brush.TextMuted}" />

                        <TextBlock Text="{Binding Decorators}"
                                   Margin="8,0,0,0"
                                   FontSize="10"
                                   Foreground="#FFD7BA7D"
                                   Visibility="{Binding Decorators, Converter={StaticResource StrToVis}}" />

                        <Border Margin="8,0,0,0"
                                Padding="3,0"
                                CornerRadius="2"
                                Background="#FF2E2A1C"
                                VerticalAlignment="Center"
                                Visibility="{Binding TierBadge, Converter={StaticResource StrToVis}}">
                            <TextBlock Text="{Binding TierBadge}" FontSize="9" Foreground="#FFE8C275" />
                        </Border>

                        <Border Margin="8,0,0,0"
                                Padding="3,0"
                                CornerRadius="2"
                                Background="#FF1D2E28"
                                VerticalAlignment="Center"
                                ToolTip="Интерфейс сервиса: берётся через dependency.instance(…)"
                                Visibility="{Binding IsServiceInterface, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="skeletons" FontSize="9" Foreground="{StaticResource Brush.OkText}" />
                        </Border>

                        <TextBlock x:Name="Homonyms"
                                   Text="{Binding HomonymText}"
                                   Margin="8,0,0,0"
                                   FontSize="10"
                                   Foreground="{StaticResource Brush.TextMuted}"
                                   ToolTip="Столько разных мест объявляют это же имя. Чем больше число, тем бесполезнее поиск ссылок без уточнения приёмником."
                                   Visibility="{Binding HomonymText, Converter={StaticResource StrToVis}}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsAmbiguous}" Value="True">
                    <Setter TargetName="Homonyms" Property="Foreground" Value="{StaticResource Brush.WarnText}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===================== запись каталога ===================== -->
        <DataTemplate x:Key="CatalogTemplate" DataType="{x:Type vm:CatalogItemViewModel}">
            <Grid Margin="6,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <!-- Шесть колбэков, которые загрузчик отдаёт моду сам. Они закреплены
                             сверху списка, и без пометки непонятно, почему они там. -->
                        <Border Margin="0,1,6,0"
                                Padding="3,0"
                                CornerRadius="2"
                                VerticalAlignment="Center"
                                Background="#FF1D2E28"
                                ToolTip="Загрузчик мода отдаёт это событие сам — подписываться не нужно"
                                Visibility="{Binding IsLoaderCallback, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="загрузчик" FontSize="9" Foreground="{StaticResource Brush.OkText}" />
                        </Border>

                        <TextBlock x:Name="Title"
                                   Text="{Binding Title}"
                                   ToolTip="{Binding ToolTipText}"
                                   FontFamily="{StaticResource Font.Mono}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource Brush.Text}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Subtitle}"
                                   FontFamily="{StaticResource Font.Mono}"
                                   FontSize="10"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource Brush.TextMuted}" />

                        <!-- В строке остаются только РАЗЛИЧАЮЩИЕ пометки: «только в бою» (160 из
                             1030) и «патч мёртв». Предупреждение про Event/SafeEvent верно для
                             99.3 % записей, поэтому оно живёт в подсказке над списком и в карточке. -->
                        <TextBlock Text="{Binding RowWarning}"
                                   Margin="8,0,0,0"
                                   FontSize="10"
                                   Foreground="{StaticResource Brush.WarnText}"
                                   Visibility="{Binding HasRowWarning, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding Badge}"
                           Margin="8,0,0,0"
                           VerticalAlignment="Top"
                           FontSize="10"
                           Foreground="{StaticResource Brush.TextMuted}" />
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsStale}" Value="True">
                    <Setter TargetName="Title" Property="Foreground" Value="{StaticResource Brush.DangerText}" />
                    <Setter TargetName="Title" Property="TextDecorations" Value="Strikethrough" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===================== попадание xref ===================== -->
        <DataTemplate x:Key="XrefTemplate" DataType="{x:Type vm:XrefHitViewModel}">
            <Grid Margin="6,2" Opacity="{Binding Hit.Tier, Converter={StaticResource TierToOpacity}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Style.KindBadge}" MinWidth="46">
                    <TextBlock Text="{Binding KindBadge}"
                               FontSize="9"
                               TextAlignment="Center"
                               Foreground="{Binding Hit.Kind, Converter={StaticResource XrefKindToBrush}}" />
                </Border>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Location}"
                               ToolTip="{Binding ToolTipText}"
                               FontSize="10"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource Brush.TextMuted}" />
                    <TextBlock x:Name="Code"
                               Text="{Binding Text}"
                               FontFamily="{StaticResource Font.Mono}"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource Brush.Text}" />
                </StackPanel>
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsNoise}" Value="True">
                    <Setter TargetName="Code" Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                    <Setter TargetName="Code" Property="FontStyle" Value="Italic" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===================== узел дерева модулей ===================== -->
        <HierarchicalDataTemplate x:Key="TreeNodeTemplate"
                                  DataType="{x:Type vm:ApiTreeNodeViewModel}"
                                  ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal"
                        Margin="0,1"
                        Opacity="{Binding Tier, Converter={StaticResource TierToOpacity}}"
                        ToolTip="{Binding ToolTipText}">
                <Border Style="{StaticResource Style.KindBadge}"
                        MinWidth="26"
                        Visibility="{Binding KindBadge, Converter={StaticResource StrToVis}}">
                    <TextBlock Text="{Binding KindBadge}"
                               FontFamily="{StaticResource Font.Mono}"
                               FontSize="9"
                               TextAlignment="Center"
                               Foreground="{Binding Symbol.Symbol.Kind, Converter={StaticResource KindToBrush}}" />
                </Border>

                <TextBlock Text="{Binding Name}"
                           FontFamily="{StaticResource Font.Mono}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource Brush.Text}" />

                <TextBlock Text="{Binding SymbolCount, StringFormat=' ({0})'}"
                           FontSize="10"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource Brush.TextMuted}"
                           Visibility="{Binding SymbolCount, Converter={StaticResource CountToVis}}" />
            </StackPanel>
        </HierarchicalDataTemplate>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== 1. СОСТОЯНИЕ ИНДЕКСА ==================== -->
        <Border Grid.Row="0" Style="{StaticResource Style.Card}" Background="{StaticResource Brush.PanelAlt}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="ИСХОДНИКИ КЛИЕНТА"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           Style="{StaticResource Style.FieldLabel}" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Style.MonoValue}"
                               Text="{Binding TreePath}"
                               ToolTip="{Binding TreePath}"
                               Visibility="{Binding TreePath, Converter={StaticResource StrToVis}}" />
                    <TextBlock Style="{StaticResource Style.Muted}"
                               Text="путь не задан"
                               Visibility="{Binding TreePath, Converter={StaticResource StrToVis}, ConverterParameter=invert}" />
                    <TextBlock Style="{StaticResource Style.Muted}" Text="{Binding IndexStatusText}" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="10,0"
                            Visibility="{Binding ShowIndexProgress, Converter={StaticResource BoolToVis}}">
                    <!-- Определённый прогресс, если Core сообщает файлы; иначе просто бегунок.
                         Появляется через 300 мс: тёплое построение (105-127 мс) не должно мигать. -->
                    <ProgressBar Width="160"
                                 Height="6"
                                 Minimum="0"
                                 Maximum="{Binding IndexStatus.FilesTotal}"
                                 Value="{Binding IndexStatus.FilesDone, Mode=OneWay}"
                                 IsIndeterminate="{Binding IndexProgressIndeterminate}" />
                    <Button Style="{StaticResource Style.SmallButton}"
                            Margin="6,0,0,0"
                            Content="отменить"
                            Command="{Binding CancelIndexCommand}" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Style.SmallButton}"
                            Margin="0,0,6,0"
                            Content="выбрать папку…"
                            Command="{Binding BrowseTreeCommand}"
                            ToolTip="Каталог с дампом uncompyle6: внутри client\, client_common\, common\" />
                    <Button Style="{StaticResource Style.SmallButton}"
                            Content="переиндексировать"
                            Command="{Binding ReindexCommand}"
                            ToolTip="Перечитать дерево целиком. Полное построение — около 0.7 с холодно и 0.1 с тепло." />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 2. ТРИ КОЛОНКИ ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="400" MinWidth="240" />
            </Grid.ColumnDefinitions>

            <!-- ================== ЛЕВО: поиск / дерево / каталоги ================== -->
            <Grid Grid.Column="0" Background="{StaticResource Brush.Panel}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="0,0,0,1"
                        Padding="6,5">
                    <WrapPanel>
                        <ToggleButton Style="{StaticResource Style.Chip}"
                                      Content="поиск"
                                      IsChecked="{Binding Pane, Converter={StaticResource EnumToBool}, ConverterParameter=Search, Mode=TwoWay}" />
                        <ToggleButton Style="{StaticResource Style.Chip}"
                                      Content="дерево"
                                      IsChecked="{Binding Pane, Converter={StaticResource EnumToBool}, ConverterParameter=Tree, Mode=TwoWay}" />
                        <ToggleButton Style="{StaticResource Style.Chip}"
                                      Content="события"
                                      IsChecked="{Binding Pane, Converter={StaticResource EnumToBool}, ConverterParameter=Events, Mode=TwoWay}"
                                      ToolTip="Каталог событий клиента. Загрузчик отдаёт моду только 6 колбэков — остальное берётся подпиской." />
                        <ToggleButton Style="{StaticResource Style.Chip}"
                                      Content="сервисы"
                                      IsChecked="{Binding Pane, Converter={StaticResource EnumToBool}, ConverterParameter=Services, Mode=TwoWay}"
                                      ToolTip="Интерфейсы из client/skeletons/**, отсортированные по числу обращений в клиенте." />
                        <ToggleButton Style="{StaticResource Style.Chip}"
                                      Content="патчи"
                                      IsChecked="{Binding Pane, Converter={StaticResource EnumToBool}, ConverterParameter=Hotspots, Mode=TwoWay}"
                                      ToolTip="Горячие точки: что на практике патчат реальные моды из mods\." />
                    </WrapPanel>
                </Border>

                <Border Grid.Row="1"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="0,0,0,1"
                        Padding="6,5">
                    <StackPanel>
                        <!-- Поле поиска символов -->
                        <Grid Visibility="{Binding Pane, Converter={StaticResource EnumToVis}, ConverterParameter=Search}">
                            <TextBox x:Name="SearchBox"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{StaticResource Font.Mono}" />
                            <TextBlock Text="имя символа: pushMessage, IItemsCache, onArenaPeriod…"
                                       Margin="8,0,0,0"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="{StaticResource Brush.TextMuted}"
                                       Visibility="{Binding SearchText, Converter={StaticResource StrToVis}, ConverterParameter=invert}" />
                        </Grid>

                        <!-- Поиск внутри каталога -->
                        <Grid Visibility="{Binding Pane, Converter={StaticResource EnumToVis}, ConverterParameter='Events,Services,Hotspots'}">
                            <TextBox Text="{Binding CatalogFilterText, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{StaticResource Font.Mono}" />
                            <TextBlock Text="фильтр по каталогу…"
                                       Margin="8,0,0,0"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="{StaticResource Brush.TextMuted}"
                                       Visibility="{Binding CatalogFilterText, Converter={StaticResource StrToVis}, ConverterParameter=invert}" />
                        </Grid>

                        <WrapPanel Margin="0,5,0,0">
                            <!-- Чипы слоёв относятся к ИНДЕКСУ (поиск и дерево). На панелях
                                 каталогов они не меняли ни одной строки: события и сервисы из
                                 stdlib и сгенерированных ресурсов не приходят в принципе.
                                 Мёртвый переключатель хуже отсутствующего, поэтому их там нет. -->
                            <ToggleButton Style="{StaticResource Style.Chip}"
                                          Content="+ ресурсы"
                                          IsChecked="{Binding IncludeGenerated}"
                                          Visibility="{Binding Pane, Converter={StaticResource EnumToVis}, ConverterParameter='Search,Tree'}"
                                          ToolTip="Показывать сгенерированные таблицы (gui/impl/gen, Scaleform/locale): 1311 файлов и 21.5 % всех символов, почти чистый шум." />
                            <ToggleButton Style="{StaticResource Style.Chip}"
                                          Content="+ stdlib"
                                          IsChecked="{Binding IncludeVendor}"
                                          Visibility="{Binding Pane, Converter={StaticResource EnumToVis}, ConverterParameter='Search,Tree'}"
                                          ToolTip="Показывать вендорный код (site-packages, common/Lib): 1167 файлов и 15 % символов, к клиенту отношения не имеют." />

                            <TextBlock Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource Style.Muted}"
                                       Text="{Binding SearchStatus}"
                                       Visibility="{Binding Pane, Converter={StaticResource EnumToVis}, ConverterParameter=Search}" />
                            <TextBlock Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource Style.Muted}"
                                       Text="{Binding CatalogStatus}"
                                       Visibility="{Binding Pane, Converter={StaticResource EnumToVis}, ConverterParameter='Events,Services,Hotspots'}" />
                        </WrapPanel>

                        <TextBlock Text="{Binding CatalogHint}"
                                   Margin="0,5,0,0"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource Brush.TextMuted}"
                                   Visibility="{Binding IsCatalogPane, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2">
                    <!-- Выдача поиска -->
                    <Grid Visibility="{Binding Pane, Converter={StaticResource EnumToVis}, ConverterParameter=Search}">
                        <ListBox ItemsSource="{Binding Results}"
                                 SelectedItem="{Binding SelectedResult}"
                                 ItemTemplate="{StaticResource SymbolTemplate}"
                                 HorizontalContentAlignment="Stretch"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

                        <TextBlock Style="{StaticResource Style.EmptyState}"
                                   FontSize="12"
                                   Text="{Binding EmptyStateText}"
                                   Visibility="{Binding Results.Count, Converter={StaticResource CountToVis}, ConverterParameter=invert}" />
                    </Grid>

                    <!-- Дерево модулей -->
                    <Grid Visibility="{Binding Pane, Converter={StaticResource EnumToVis}, ConverterParameter=Tree}">
                        <TreeView x:Name="ModuleTree"
                                  ItemsSource="{Binding TreeRoots}"
                                  ItemTemplate="{StaticResource TreeNodeTemplate}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  SelectedItemChanged="OnTreeSelectionChanged"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <TreeView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </TreeView.ItemsPanel>
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                        </TreeView>

                        <TextBlock Style="{StaticResource Style.EmptyState}"
                                   FontSize="12"
                                   Text="{Binding EmptyStateText}"
                                   Visibility="{Binding TreeRoots.Count, Converter={StaticResource CountToVis}, ConverterParameter=invert}" />
                    </Grid>

                    <!-- Каталоги -->
                    <Grid Visibility="{Binding Pane, Converter={StaticResource EnumToVis}, ConverterParameter='Events,Services,Hotspots'}">
                        <ListBox ItemsSource="{Binding CatalogItems}"
                                 SelectedItem="{Binding SelectedCatalogItem}"
                                 ItemTemplate="{StaticResource CatalogTemplate}"
                                 HorizontalContentAlignment="Stretch"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

                        <TextBlock Style="{StaticResource Style.EmptyState}"
                                   FontSize="12"
                                   Text="{Binding CatalogEmptyText}"
                                   Visibility="{Binding CatalogItems.Count, Converter={StaticResource CountToVis}, ConverterParameter=invert}" />
                    </Grid>
                </Grid>

                <!-- Одна полоска на все длинные операции левой колонки. У построения каталогов
                     (657-924 мс — самая долгая операция экрана) здесь же есть и отмена: раньше
                     оно шло с CancellationToken.None и прервать его было нечем. -->
                <Border Grid.Row="3"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="0,1,0,0"
                        Padding="6,4"
                        Visibility="{Binding LeftBusyText, Converter={StaticResource StrToVis}}">
                    <Grid>
                        <TextBlock Style="{StaticResource Style.Muted}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding LeftBusyText}" />
                        <Button HorizontalAlignment="Right"
                                Style="{StaticResource Style.SmallButton}"
                                Content="отменить"
                                Command="{Binding CancelCatalogCommand}"
                                Visibility="{Binding IsCatalogLoading, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

            <!-- ================== ЦЕНТР: исходник ================== -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Style.Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="{Binding SourceTitle}"
                                       ToolTip="{Binding SourceTitle}"
                                       FontFamily="{StaticResource Font.Mono}"
                                       FontSize="13"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource Brush.Text}" />

                            <TextBlock Text="{Binding SourceSubtitle}"
                                       Style="{StaticResource Style.Muted}"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding SourceSubtitle, Converter={StaticResource StrToVis}}" />

                            <!-- Виртуальный путь — то самое поле, которым оперирует traceback
                                 в python.log. Он и связывает этот экран с лентой этапа 1. -->
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <TextBlock Text="traceback:"
                                           FontSize="10"
                                           VerticalAlignment="Center"
                                           Margin="0,0,5,0"
                                           Foreground="{StaticResource Brush.TextMuted}" />
                                <TextBlock Text="{Binding SourceVirtualPath}"
                                           ToolTip="Путь, которым оперирует traceback в python.log"
                                           FontFamily="{StaticResource Font.Mono}"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="#FF6FB3E0" />
                            </StackPanel>

                            <!-- Предупреждение по ВЫБРАННОЙ записи каталога. В строке списка его
                                 нет намеренно: «Event, а не SafeEvent» верно у 1023 записей из
                                 1030, то есть на строке это чистый шум, а здесь — ровно то, что
                                 надо прочитать до копирования сниппета. -->
                            <Border Margin="0,4,0,2"
                                    Padding="6,3"
                                    CornerRadius="2"
                                    Background="{StaticResource Brush.WarnBg}"
                                    Visibility="{Binding CatalogWarning, Converter={StaticResource StrToVis}}">
                                <TextBlock Text="{Binding CatalogWarning}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource Brush.WarnText}" />
                            </Border>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="на диске:"
                                           FontSize="10"
                                           VerticalAlignment="Center"
                                           Margin="0,0,5,0"
                                           Foreground="{StaticResource Brush.TextMuted}" />
                                <TextBlock Text="{Binding SourcePath}"
                                           ToolTip="{Binding SourcePath}"
                                           FontFamily="{StaticResource Font.Mono}"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource Brush.TextMuted}" />
                                <TextBlock Text="{Binding ElementName=Source, Path=Notice}"
                                           Margin="8,0,0,0"
                                           FontSize="10"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource Brush.WarnText}" />
                            </StackPanel>
                        </StackPanel>

                        <WrapPanel Grid.Column="1" VerticalAlignment="Top">
                            <Button Style="{StaticResource Style.SmallButton}"
                                    Margin="0,0,6,4"
                                    Content="открыть в VS Code"
                                    Command="{Binding OpenInEditorCommand}" />
                            <Button Style="{StaticResource Style.SmallButton}"
                                    Margin="0,0,6,4"
                                    Content="копировать импорт"
                                    Command="{Binding CopyImportCommand}"
                                    ToolTip="Строка import для выбранного символа. Метод импортировать нельзя — копируется его класс." />
                            <Button Style="{StaticResource Style.SmallButton}"
                                    Margin="0,0,6,4"
                                    Content="вирт. путь"
                                    Command="{Binding CopyVirtualPathCommand}"
                                    ToolTip="Скопировать путь вида scripts/client/... — им traceback и оперирует." />
                            <Button Style="{StaticResource Style.SmallButton}"
                                    Margin="0,0,0,4"
                                    Content="путь на диске"
                                    Command="{Binding CopyDiskPathCommand}" />
                        </WrapPanel>
                    </Grid>
                </Border>

                <controls:PythonSourceView x:Name="Source"
                                           Grid.Row="1"
                                           SourcePath="{Binding SourcePath}"
                                           HighlightedLine="{Binding SourceLine}"
                                           EmptyText="{Binding EmptyStateText}" />
            </Grid>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

            <!-- ================== ПРАВО: ссылки и сниппеты ================== -->
            <Grid Grid.Column="4" Background="{StaticResource Brush.Panel}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="120" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="260" MinHeight="90" />
                </Grid.RowDefinitions>

                <!-- xref -->
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource Brush.PanelAlt}"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="0,0,0,1"
                            Padding="8,5">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="где это вызывается" VerticalAlignment="Center" />
                                <Button HorizontalAlignment="Right"
                                        Style="{StaticResource Style.SmallButton}"
                                        Content="повторить"
                                        Command="{Binding RerunXrefCommand}" />
                            </Grid>

                            <TextBlock Text="{Binding XrefTitle}"
                                       FontFamily="{StaticResource Font.Mono}"
                                       FontSize="12"
                                       Margin="0,3,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="#FF6FB3E0"
                                       Visibility="{Binding XrefTitle, Converter={StaticResource StrToVis}}" />

                            <TextBlock Text="{Binding XrefStatus}"
                                       Style="{StaticResource Style.Muted}"
                                       TextWrapping="Wrap" />

                            <TextBlock Text="{Binding XrefReceiverHint}"
                                       FontFamily="{StaticResource Font.Mono}"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource Brush.WarnText}"
                                       ToolTip="Самые частые приёмники этого имени в клиенте — готовые кандидаты, чтобы сузить поиск"
                                       Visibility="{Binding XrefReceiverHint, Converter={StaticResource StrToVis}}" />

                            <WrapPanel Margin="0,4,0,0">
                                <ToggleButton Style="{StaticResource Style.Chip}"
                                              Content="приёмник"
                                              IsChecked="{Binding XrefUseReceiver}"
                                              ToolTip="Искать «владелец.имя» вместо голого имени. Замерено: settings.update даёт 21 попадание против 12 625." />
                                <ToggleButton Style="{StaticResource Style.Chip}"
                                              Content="Aa"
                                              IsChecked="{Binding XrefIgnoreCase}"
                                              ToolTip="Игнорировать регистр. В 6-10 раз дороже полного прохода, поэтому выключено по умолчанию." />

                                <TextBlock Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="10"
                                           Foreground="{StaticResource Brush.TextMuted}"
                                           Text="границы слова всегда вкл"
                                           ToolTip="Совпадения внутри других идентификаторов отбрасываются всегда: без этого getVehicle даёт 2587 попаданий вместо 143, то есть панель просто не работает." />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <ListBox ItemsSource="{Binding XrefHits}"
                                 SelectedItem="{Binding SelectedXrefHit}"
                                 ItemTemplate="{StaticResource XrefTemplate}"
                                 HorizontalContentAlignment="Stretch"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

                        <TextBlock Style="{StaticResource Style.EmptyState}"
                                   FontSize="12"
                                   Text="Выберите символ слева — здесь появятся места, где он упоминается в клиенте.&#10;&#10;Полный проход по 59 МБ исходников занимает единицы миллисекунд, поэтому список строится сразу при выборе."
                                   Visibility="{Binding XrefHits.Count, Converter={StaticResource CountToVis}, ConverterParameter=invert}" />
                    </Grid>
                </Grid>

                <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center" />

                <!-- сниппеты -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource Brush.PanelAlt}"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="0,0,0,1"
                            Padding="8,5">
                        <StackPanel>
                            <TextBlock Text="сниппеты — код кладётся в буфер обмена" />

                            <!-- Для чего именно будет собран сниппет. Без этой строки кнопки
                                 действуют вслепую: выбор символа и выбор записи каталога живут
                                 в разных панелях, и какая из них сейчас цель — не видно. -->
                            <TextBlock Text="{Binding SnippetTarget}"
                                       Style="{StaticResource Style.Muted}"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding SnippetTarget}"
                                       Visibility="{Binding SnippetTarget, Converter={StaticResource StrToVis}}" />

                            <WrapPanel Margin="0,5,0,0">
                                <!-- Рекомендованный каталогом вариант. Он отличается от трёх
                                     кнопок ниже тем, что каталог знает КОНТЕКСТ: у события
                                     боевого владельца (arena, sessionProvider.shared.<слот>)
                                     подписка обязана быть двухступенчатой, потому что вне боя
                                     владельца не существует вовсе. Вручную такой выбор
                                     сделать неоткуда. -->
                                <Button Style="{StaticResource Style.SmallButton}"
                                        Margin="0,0,4,4"
                                        Content="рекомендуемый"
                                        Command="{Binding CopyCatalogSnippetCommand}"
                                        Visibility="{Binding HasCatalogSnippet, Converter={StaticResource BoolToVis}}"
                                        ToolTip="Сниппет, подобранный под выбранную запись каталога: для события — подписка (двухступенчатая, если владелец живёт только в бою), для сервиса — dependency, для горячей точки — монкипатч." />
                                <Button Style="{StaticResource Style.SmallButton}"
                                        Margin="0,0,4,4"
                                        Content="подписка"
                                        Command="{Binding CopySnippetCommand}"
                                        CommandParameter="{x:Static api:ApiSnippetKind.EventSubscription}"
                                        ToolTip="Подписка на событие: флаг однократности, отписка в fini(), тело обработчика целиком в try/except. Если владелец существует только в бою (arena, sessionProvider.shared.&lt;слот&gt;), подписка автоматически становится двухступенчатой — через onAvatarBecomePlayer." />
                                <Button Style="{StaticResource Style.SmallButton}"
                                        Margin="0,0,4,4"
                                        Content="монкипатч"
                                        Command="{Binding CopySnippetCommand}"
                                        CommandParameter="{x:Static api:ApiSnippetKind.MonkeyPatch}"
                                        ToolTip="Безопасная обёртка: оригинал берётся через getattr в момент установки, вызывается первым, свой код в отдельном try/except, fini() гасит флаг, а не восстанавливает setattr." />
                                <Button Style="{StaticResource Style.SmallButton}"
                                        Margin="0,0,0,4"
                                        Content="сервис"
                                        Command="{Binding CopySnippetCommand}"
                                        CommandParameter="{x:Static api:ApiSnippetKind.ServiceAccess}"
                                        ToolTip="Получение сервиса через helpers.dependency с проверкой всех трёх режимов отказа." />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <TextBox Text="{Binding SnippetPreview, Mode=OneWay}"
                                 IsReadOnly="True"
                                 FontFamily="{StaticResource Font.Mono}"
                                 FontSize="11"
                                 Background="#FF17171A"
                                 BorderThickness="0"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"
                                 TextWrapping="NoWrap" />

                        <TextBlock Style="{StaticResource Style.EmptyState}"
                                   FontSize="11"
                                   Text="Выберите символ или запись каталога и нажмите кнопку сниппета.&#10;Скопированный код показывается здесь целиком — вслепую в чужой проект он не уезжает."
                                   Visibility="{Binding HasSnippet, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    </Grid>

                    <Border Grid.Row="2"
                            Padding="8,5"
                            Background="{StaticResource Brush.WarnBg}"
                            BorderBrush="#FF5C5030"
                            BorderThickness="0,1,0,0"
                            Visibility="{Binding SnippetNote, Converter={StaticResource StrToVis}}">
                        <TextBlock Text="{Binding SnippetNote}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource Brush.WarnText}" />
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ==================== 3. СТРОКА СОСТОЯНИЯ ==================== -->
        <Border Grid.Row="2"
                Background="{StaticResource Brush.Panel}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,1,0,0"
                Padding="10,4">
            <TextBlock Style="{StaticResource Style.Muted}"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding StatusMessage}"
                       ToolTip="{Binding StatusMessage}" />
        </Border>
    </Grid>
</UserControl>
