<UserControl x:Class="WotModCockpit.App.Views.ProblemsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:WotModCockpit.App.Converters"
             xmlns:vm="clr-namespace:WotModCockpit.App.ViewModels"
             Background="{StaticResource Brush.Panel}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:StringToVisibilityConverter x:Key="StrToVis" />
        <conv:CountToVisibilityConverter x:Key="CountToVis" />
        <conv:EnumToBooleanConverter x:Key="EnumToBool" />
        <conv:ProblemSeverityToBrushConverter x:Key="SeverityToBrush" />

        <!-- Строка находки. Значок серьёзности — три буквы, как в браузере API:
             в списке на сотни строк они читаются быстрее иконок и не зависят от темы. -->
        <DataTemplate x:Key="ProblemTemplate" DataType="{x:Type vm:ProblemItemViewModel}">
            <Grid Margin="6,2" ToolTip="{Binding ToolTipText}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        CornerRadius="2"
                        Padding="4,0"
                        Margin="0,1,6,1"
                        MinWidth="34"
                        VerticalAlignment="Top"
                        Background="#FF232327"
                        BorderBrush="#FF3A3A41"
                        BorderThickness="1">
                    <TextBlock Text="{Binding SeverityBadge}"
                               FontFamily="{StaticResource Font.Mono}"
                               FontSize="10"
                               TextAlignment="Center"
                               Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                </Border>

                <TextBlock Grid.Column="1"
                           Text="{Binding Code}"
                           MinWidth="64"
                           Margin="0,0,8,0"
                           FontFamily="{StaticResource Font.Mono}"
                           FontSize="11"
                           VerticalAlignment="Top"
                           Foreground="{StaticResource Brush.TextMuted}" />

                <StackPanel Grid.Column="2">
                    <TextBlock Text="{Binding Message}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource Brush.Text}" />
                    <TextBlock Text="{Binding Snippet}"
                               FontFamily="{StaticResource Font.Mono}"
                               FontSize="10"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource Brush.TextMuted}"
                               Visibility="{Binding Snippet, Converter={StaticResource StrToVis}}" />
                </StackPanel>

                <TextBlock Grid.Column="3"
                           Text="{Binding Location}"
                           Margin="8,0,0,0"
                           VerticalAlignment="Top"
                           FontFamily="{StaticResource Font.Mono}"
                           FontSize="10"
                           Foreground="{StaticResource Brush.TextMuted}" />
            </Grid>
        </DataTemplate>

        <!-- Заголовок группы: файл, правило или уровень — смотря что выбрано в тулбаре. -->
        <Style x:Key="Style.GroupHeader" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            <Setter Property="Margin" Value="6,6,0,2" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== ТУЛБАР ==================== -->
        <Border Grid.Row="0"
                Background="{StaticResource Brush.PanelAlt}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,1,0,1"
                Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="PROBLEMS"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               Style="{StaticResource Style.FieldLabel}" />

                    <ToggleButton Style="{StaticResource Style.Chip}"
                                  IsChecked="{Binding ShowErrors}"
                                  ToolTip="Находки уровня «клиент закроется» или «мод не загрузится»">
                        <TextBlock>
                            <Run Text="ошибки" />
                            <Run Text="{Binding ErrorCount, Mode=OneWay}" Foreground="{StaticResource Log.Error}" />
                        </TextBlock>
                    </ToggleButton>

                    <ToggleButton Style="{StaticResource Style.Chip}"
                                  IsChecked="{Binding ShowWarnings}"
                                  ToolTip="Сломается вероятностно: утечки подписок, незакрытые петли колбэков, исключения из обработчиков">
                        <TextBlock>
                            <Run Text="предупр." />
                            <Run Text="{Binding WarningCount, Mode=OneWay}" Foreground="{StaticResource Log.Warning}" />
                        </TextBlock>
                    </ToggleButton>

                    <ToggleButton Style="{StaticResource Style.Chip}"
                                  IsChecked="{Binding ShowInfos}"
                                  ToolTip="Мод исправен, но факт про клиент знать полезно">
                        <TextBlock>
                            <Run Text="замечания" />
                            <Run Text="{Binding InfoCount, Mode=OneWay}" Foreground="{StaticResource Brush.TextMuted}" />
                        </TextBlock>
                    </ToggleButton>

                    <Separator Width="1" Margin="6,4" Background="{StaticResource Brush.Border}" />

                    <ToggleButton Style="{StaticResource Style.Chip}"
                                  Content="по файлу"
                                  IsChecked="{Binding Grouping, Converter={StaticResource EnumToBool}, ConverterParameter=File, Mode=TwoWay}" />
                    <ToggleButton Style="{StaticResource Style.Chip}"
                                  Content="по правилу"
                                  IsChecked="{Binding Grouping, Converter={StaticResource EnumToBool}, ConverterParameter=Rule, Mode=TwoWay}"
                                  ToolTip="Видно, какое правило даёт основной поток замечаний" />
                    <ToggleButton Style="{StaticResource Style.Chip}"
                                  Content="по важности"
                                  IsChecked="{Binding Grouping, Converter={StaticResource EnumToBool}, ConverterParameter=Severity, Mode=TwoWay}" />

                    <Grid Width="200" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="{StaticResource Font.Mono}"
                                 FontSize="11" />
                        <TextBlock Text="фильтр: WOT001, имя файла…"
                                   Margin="8,0,0,0"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{StaticResource Brush.TextMuted}"
                                   Visibility="{Binding SearchText, Converter={StaticResource StrToVis}, ConverterParameter=invert}" />
                    </Grid>
                </WrapPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar Width="90"
                                 Height="6"
                                 Margin="0,0,6,0"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource Style.SmallButton}"
                            Margin="0,0,6,0"
                            Content="отменить"
                            Command="{Binding CancelCommand}"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource Style.SmallButton}"
                            Margin="0,0,6,0"
                            Content="проверить"
                            Command="{Binding AnalyzeCommand}"
                            ToolTip="Прогнать preflight по коду мода. Ничего не пишет ни в проект, ни в игру." />
                    <Button Style="{StaticResource Style.SmallButton}"
                            Content="копировать"
                            Command="{Binding CopyProblemsCommand}"
                            ToolTip="Скопировать показанные находки текстом — как вывод линтера" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== СПИСОК И ПОДРОБНОСТИ ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="360" MinWidth="180" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <ListBox x:Name="ProblemList"
                         ItemsSource="{Binding Problems}"
                         SelectedItem="{Binding Selected}"
                         ItemTemplate="{StaticResource ProblemTemplate}"
                         HorizontalContentAlignment="Stretch"
                         MouseDoubleClick="OnListDoubleClick"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <!-- Те же три команды правой кнопкой. Без этого единственным жестом
                         перехода в VS Code был двойной щелчок, о котором нигде не написано,
                         а жеста перехода в браузер API из списка не было вообще. -->
                    <ListBox.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="Открыть в VS Code"
                                      InputGestureText="двойной щелчок"
                                      Command="{Binding OpenInEditorCommand}" />
                            <MenuItem Header="Показать в браузере API"
                                      Command="{Binding OpenInApiBrowserCommand}" />
                            <Separator />
                            <MenuItem Header="Скрыть это правило до следующего запуска"
                                      Command="{Binding MuteRuleCommand}" />
                        </ContextMenu>
                    </ListBox.ContextMenu>

                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource Style.GroupHeader}">
                                        <Run Text="{Binding Name, Mode=OneWay}" />
                                        <Run Text="{Binding ItemCount, Mode=OneWay, StringFormat=' ({0})'}"
                                             Foreground="{StaticResource Brush.TextMuted}" />
                                    </TextBlock>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                </ListBox>

                <TextBlock Style="{StaticResource Style.EmptyState}"
                           FontSize="12"
                           Text="{Binding EmptyStateText}"
                           Visibility="{Binding Problems.Count, Converter={StaticResource CountToVis}, ConverterParameter=invert}" />
            </Grid>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

            <!-- ПОЧЕМУ ЭТО ПЛОХО. Ради этой колонки панель и существует: список кодов без
                 объяснения последствия ничему не учит, а половина правил опирается на факты
                 про загрузчик, которые мододел не обязан помнить наизусть. -->
            <Border Grid.Column="2" Background="{StaticResource Brush.Window}">
                <!-- Две строки, а не один ScrollViewer на всё. Измерено на живом окне: при
                     высоте дока 230 px viewport карточки = 143 px, а полоса действий лежала
                     последней внутри прокрутки на y=335 — то есть на 192 px ниже видимой
                     области, и WPF честно рапортовал apiButton.IsVisible=False. Кнопки
                     «открыть в VS Code» / «показать в браузере API» / «скрыть правило»
                     не видел никто. Теперь прокручивается только текст, а действия закреплены. -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="выберите находку слева"
                                   Style="{StaticResource Style.Muted}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />

                        <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Selected.Code}"
                                           FontFamily="{StaticResource Font.Mono}"
                                           FontSize="13"
                                           Foreground="{Binding Selected.Severity, Converter={StaticResource SeverityToBrush}}" />
                                <TextBlock Text="{Binding Selected.Source}"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource Style.Muted}" />
                            </StackPanel>

                            <TextBlock Text="{Binding Selected.Message}"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource Brush.Text}" />

                            <TextBlock Text="ПОЧЕМУ ЭТО ПЛОХО"
                                       Margin="0,10,0,2"
                                       Style="{StaticResource Style.FieldLabel}"
                                       Visibility="{Binding SelectedExplanation, Converter={StaticResource StrToVis}}" />
                            <TextBlock Text="{Binding SelectedExplanation}"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="{StaticResource Brush.Text}"
                                       Visibility="{Binding SelectedExplanation, Converter={StaticResource StrToVis}}" />

                            <TextBlock Text="КАК ЧИНИТЬ"
                                       Margin="0,10,0,2"
                                       Style="{StaticResource Style.FieldLabel}"
                                       Visibility="{Binding SelectedHint, Converter={StaticResource StrToVis}}" />
                            <TextBlock Text="{Binding SelectedHint}"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="{StaticResource Brush.OkText}"
                                       Visibility="{Binding SelectedHint, Converter={StaticResource StrToVis}}" />

                            <TextBlock Text="ОСНОВАНИЕ В КЛИЕНТЕ"
                                       Margin="0,10,0,2"
                                       Style="{StaticResource Style.FieldLabel}"
                                       Visibility="{Binding SelectedReference, Converter={StaticResource StrToVis}}" />
                            <TextBlock Text="{Binding SelectedReference}"
                                       FontFamily="{StaticResource Font.Mono}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="#FF6FB3E0"
                                       Visibility="{Binding SelectedReference, Converter={StaticResource StrToVis}}" />

                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                    <!-- Полоса действий. Ради неё всё и переделано в две строки: она обязана
                         быть видна при любой высоте дока, иначе связки Problems -> VS Code
                         и Problems -> браузер API существуют только в коде. -->
                    <Border Grid.Row="1"
                            Background="{StaticResource Brush.PanelAlt}"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="0,1,0,0"
                            Padding="10,6"
                            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <WrapPanel>
                            <Button Style="{StaticResource Style.SmallButton}"
                                    Margin="0,0,6,4"
                                    Content="открыть в VS Code"
                                    Command="{Binding OpenInEditorCommand}"
                                    ToolTip="То же самое делает двойной щелчок по строке списка" />
                            <Button Style="{StaticResource Style.SmallButton}"
                                    Margin="0,0,6,4"
                                    Content="показать в браузере API"
                                    Command="{Binding OpenInApiBrowserCommand}"
                                    ToolTip="Открыть исходник клиента, из-за которого правило существует, либо символ, которого не нашлось" />
                            <Button Style="{StaticResource Style.SmallButton}"
                                    Margin="0,0,0,4"
                                    Content="скрыть правило"
                                    Command="{Binding MuteRuleCommand}"
                                    ToolTip="Следующий прогон это правило считать не будет. Панель честно напишет, сколько правил скрыто." />
                        </WrapPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== НИЖНЯЯ ПОЛОСКА ==================== -->
        <Border Grid.Row="2"
                Background="{StaticResource Brush.PanelAlt}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,1,0,0"
                Padding="8,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Style.Muted}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding StatusText}"
                               ToolTip="{Binding StatusText}" />

                    <TextBlock Style="{StaticResource Style.Muted}"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource Brush.WarnText}"
                               Text="{Binding MutedText}"
                               Visibility="{Binding MutedText, Converter={StaticResource StrToVis}}" />

                    <Button Style="{StaticResource Style.SmallButton}"
                            Margin="6,0,0,0"
                            Content="показать все правила"
                            Command="{Binding ResetMutedRulesCommand}"
                            Visibility="{Binding MutedText, Converter={StaticResource StrToVis}}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ToggleButton Style="{StaticResource Style.Chip}"
                                  Content="перед сборкой"
                                  IsChecked="{Binding AnalyzeBeforeBuild}"
                                  ToolTip="Проверять перед запуском build.py. Сборку это НЕ блокирует: при ошибках кокпит только спросит подтверждение." />
                    <ToggleButton Style="{StaticResource Style.Chip}"
                                  Content="при открытии"
                                  IsChecked="{Binding AnalyzeOnOpen}"
                                  ToolTip="Проверять сразу при открытии проекта" />
                    <ToggleButton Style="{StaticResource Style.Chip}"
                                  Content="pyright"
                                  IsChecked="{Binding RunPyright}"
                                  ToolTip="{Binding PyrightStatus}" />
                    <TextBlock Style="{StaticResource Style.Muted}"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               MaxWidth="260"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding PyrightStatus}"
                               ToolTip="{Binding PyrightStatus}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
