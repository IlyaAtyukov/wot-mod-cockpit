<controls:ChromeWindow x:Class="WotModCockpit.App.Views.SetupBundleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:WotModCockpit.App.Converters"
        xmlns:controls="clr-namespace:WotModCockpit.App.Controls"
        xmlns:vm="clr-namespace:WotModCockpit.App.ViewModels"
        Title="Собрать сетап из своих модов"
        Icon="/WotModCockpit.App;component/Resources/cockpit.ico"
        Width="760"
        Height="720"
        MinWidth="600"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <!--
        ДИАЛОГ «СОБРАТЬ СЕТАП».

        Отмеченные свои моды упаковываются в один Setup.exe (заглушка WotModCockpit.Setup +
        архив с модами). В самом сетапе человек снова видит список с галочками и выбирает, что
        поставить.

        Галочки — только здесь. На экране «Моды» их нет намеренно: там лежат чужие моды, и
        массовые операции над ними опасны. Здесь в списке только свои проекты, а итог — файл в
        папке сетапов: в каталог игры диалог не пишет ничего.
    -->

    <controls:ChromeWindow.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:StringToVisibilityConverter x:Key="StrToVis" />
        <conv:CountToVisibilityConverter x:Key="CountToVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />

        <Style x:Key="Style.DialogLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <!-- Строка проекта: галочка, имя, id с версией и состояние сборки. -->
        <DataTemplate x:Key="ComponentRow" DataType="{x:Type vm:SetupComponentViewModel}">
            <Border Padding="10,6" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding IsChecked}"
                              ToolTip="{Binding Description}">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Style.Muted}" FontFamily="{StaticResource Font.Mono}">
                                <Run Text="{Binding ModId, Mode=OneWay}" />
                                <Run Text="·" />
                                <Run Text="{Binding Version, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </CheckBox>

                    <TextBlock Grid.Column="1"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Text="{Binding BuildState}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.WarnText}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </DataTemplate>
    </controls:ChromeWindow.Resources>

    <Grid Margin="18,12,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="140" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource Brush.TextMuted}"
                   Text="Отмеченные моды упакуются в один Setup.exe. В нём человек сам отметит, что поставить; прежние версии этих модов установщик выключит (.mtmod.off), а не удалит, чужие моды не тронет. В игру отсюда не пишется ничего." />

        <Grid Grid.Row="1" Margin="0,14,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource Style.DialogLabel}" Margin="0" VerticalAlignment="Bottom" Text="СВОИ МОДЫ" />
            <TextBlock Grid.Column="1" Style="{StaticResource Style.Muted}" VerticalAlignment="Center" Margin="0,0,14,0" Text="{Binding SelectionSummary}" />
            <Button x:Name="SelectAllButton" Grid.Column="2" Style="{StaticResource Style.LinkButton}" Margin="0,0,12,0" Content="все" Command="{Binding SelectAllCommand}" />
            <Button x:Name="SelectNoneButton" Grid.Column="3" Style="{StaticResource Style.LinkButton}" Content="ни одного" Command="{Binding SelectNoneCommand}" />
        </Grid>

        <Border Grid.Row="2"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="3"
                Background="{StaticResource Brush.Panel}">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ComponentList"
                                  ItemsSource="{Binding Components}"
                                  ItemTemplate="{StaticResource ComponentRow}"
                                  IsEnabled="{Binding IsIdle}" />
                </ScrollViewer>
                <TextBlock Style="{StaticResource Style.EmptyState}"
                           Margin="16"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Text="Своих проектов не найдено. Кокпит ищет их рядом с открытым и недавними проектами: в каталоге проекта должны быть build.py, src\ и src\meta.xml."
                           Visibility="{Binding Components.Count, Converter={StaticResource CountToVis}, ConverterParameter=invert}" />
            </Grid>
        </Border>

        <!-- ============================ ПАРАМЕТРЫ ============================ -->
        <Grid Grid.Row="3" Margin="0,14,0,0" IsEnabled="{Binding IsIdle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="170" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Style.DialogLabel}" Text="ИМЯ СБОРКИ" />
            <TextBox x:Name="NameBox"
                     Grid.Row="1"
                     Grid.Column="0"
                     ToolTip="Заголовок окна сетапа и начало имени файла"
                     Text="{Binding BundleName, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Style.DialogLabel}" Text="ВЕРСИЯ" />
            <TextBox x:Name="VersionBox"
                     Grid.Row="1"
                     Grid.Column="2"
                     FontFamily="{StaticResource Font.Mono}"
                     ToolTip="По умолчанию — сегодняшняя дата. Латинские буквы, цифры и знаки . - _ +"
                     Text="{Binding BundleVersion, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,0,4" Style="{StaticResource Style.DialogLabel}" Text="ПАПКА ДЛЯ СЕТАПА" />
            <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="OutputDirBox" Grid.Column="0" FontFamily="{StaticResource Font.Mono}" Text="{Binding OutputDir, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1" Style="{StaticResource Style.SmallButton}" Margin="6,0,0,0" Content="Обзор…" Command="{Binding BrowseOutputCommand}" />
            </Grid>

            <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0">
                <TextBlock Style="{StaticResource Style.Muted}" TextWrapping="Wrap">
                    <Run Text="будет создан" />
                    <Run Text="{Binding OutputPath, Mode=OneWay}" FontFamily="{StaticResource Font.Mono}" Foreground="{StaticResource Brush.Text}" />
                </TextBlock>
                <CheckBox x:Name="RebuildBox" Margin="0,10,0,0" IsChecked="{Binding Rebuild}">
                    <TextBlock TextWrapping="Wrap" Text="Пересобрать отмеченные перед упаковкой — build.py без установки в игру; вывод идёт на экран «Сборка и лог»" />
                </CheckBox>
            </StackPanel>
        </Grid>

        <!-- ============================ ПРЕДУПРЕЖДЕНИЯ ============================ -->
        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <Border Background="{StaticResource Brush.DangerBg}"
                    CornerRadius="3"
                    Padding="10,6"
                    Visibility="{Binding Problem, Converter={StaticResource StrToVis}}">
                <TextBlock x:Name="ProblemText" Foreground="{StaticResource Brush.DangerText}" TextWrapping="Wrap" Text="{Binding Problem}" />
            </Border>
            <Border Background="{StaticResource Brush.WarnBg}"
                    CornerRadius="3"
                    Padding="10,6"
                    Margin="0,6,0,0"
                    Visibility="{Binding Warning, Converter={StaticResource StrToVis}}">
                <TextBlock Foreground="{StaticResource Brush.WarnText}" TextWrapping="Wrap" Text="{Binding Warning}" />
            </Border>
        </StackPanel>

        <!-- ============================ ХОД СБОРКИ ============================ -->
        <StackPanel Grid.Row="5" Margin="0,10,0,0">
            <TextBlock x:Name="StatusLine"
                       TextWrapping="Wrap"
                       Text="{Binding StatusText}"
                       Visibility="{Binding StatusText, Converter={StaticResource StrToVis}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LastRunSucceeded}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Brush.OkText}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <ListBox x:Name="LogList"
                     Margin="0,6,0,0"
                     MaxHeight="110"
                     FontFamily="{StaticResource Font.Mono}"
                     FontSize="11"
                     ItemsSource="{Binding Log}"
                     Visibility="{Binding Log.Count, Converter={StaticResource CountToVis}}" />
        </StackPanel>

        <!-- ============================ КНОПКИ ============================ -->
        <StackPanel Grid.Row="6" Margin="0,14,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="OpenFolderButton"
                    Content="Показать в папке"
                    MinWidth="140"
                    Margin="0,0,8,0"
                    Command="{Binding OpenFolderCommand}"
                    Visibility="{Binding ResultPath, Converter={StaticResource NullToVis}}" />
            <Button x:Name="BuildButton"
                    Content="Собрать сетап"
                    MinWidth="140"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Command="{Binding BuildCommand}" />
            <Button x:Name="CloseButton"
                    Content="Закрыть"
                    MinWidth="90"
                    IsCancel="True"
                    Command="{Binding CloseCommand}" />
        </StackPanel>
    </Grid>
</controls:ChromeWindow>
