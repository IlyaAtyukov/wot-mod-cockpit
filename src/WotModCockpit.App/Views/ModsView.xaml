<UserControl x:Class="WotModCockpit.App.Views.ModsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:WotModCockpit.App.Converters"
             xmlns:vm="clr-namespace:WotModCockpit.App.ViewModels"
             Background="{StaticResource Brush.Window}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:StringToVisibilityConverter x:Key="StrToVis" />
        <conv:CountToVisibilityConverter x:Key="CountToVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />

        <!-- Строка списка. Слева полоса «моё» (тот же приём, что у своих строк лога),
             потом иконка: либо настоящая из архива мода, либо плитка с буквой.
             Прятать выключенные моды нельзя, поэтому они не исчезают, а гаснут. -->
        <DataTemplate x:Key="ModRowTemplate" DataType="{x:Type vm:InstalledModViewModel}">
            <Grid Margin="0,2" ToolTip="{Binding ToolTipText}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border x:Name="MineBar" Grid.Column="0" Background="Transparent" />

                <Grid x:Name="IconBox"
                      Grid.Column="1"
                      Width="24"
                      Height="24"
                      Margin="6,0,7,0"
                      VerticalAlignment="Center">
                    <Border CornerRadius="4"
                            Background="{Binding PlateBrush}"
                            Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <TextBlock Text="{Binding PlateLetter}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#FF15151A" />
                    </Border>
                    <Image Source="{Binding Icon}"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="Title"
                               Text="{Binding Title}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource Brush.Text}" />
                    <TextBlock x:Name="Sub"
                               Text="{Binding Subtitle}"
                               FontSize="10"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource Brush.TextMuted}" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,6,0">
                    <TextBlock Text="⚠"
                               Margin="0,0,4,0"
                               FontSize="11"
                               Foreground="{StaticResource Brush.WarnText}"
                               ToolTip="мод несёт нативные модули (.pyd/.dll) — он лезет в процесс игры"
                               Visibility="{Binding HasNativeCode, Converter={StaticResource BoolToVis}}" />
                    <TextBlock x:Name="State"
                               Text=""
                               FontSize="10"
                               Foreground="{StaticResource Brush.TextMuted}" />
                </StackPanel>
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMine}" Value="True">
                    <Setter TargetName="MineBar" Property="Background" Value="{StaticResource Log.Mine.Bar}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                    <Setter TargetName="Title" Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                    <Setter TargetName="IconBox" Property="Opacity" Value="0.45" />
                    <Setter TargetName="State" Property="Text" Value="выкл" />
                </DataTrigger>
                <!-- Проект, которого в игре нет (в том числе только что удалённый мод). Строка стоит
                     на прежнем месте, с той же иконкой из dist и тем же именем, поэтому отличие
                     обязано читаться с первого взгляда, а не мелкой надписью справа. -->
                <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                    <Setter TargetName="State" Property="Text" Value="НЕ УСТАНОВЛЕН" />
                    <Setter TargetName="State" Property="FontWeight" Value="Bold" />
                    <Setter TargetName="State" Property="Foreground" Value="{StaticResource Brush.WarnText}" />
                    <Setter TargetName="Title" Property="FontStyle" Value="Italic" />
                    <Setter TargetName="IconBox" Property="Opacity" Value="0.3" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasDuplicateId}" Value="True">
                    <Setter TargetName="Sub" Property="Foreground" Value="{StaticResource Brush.DangerText}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="Style.GroupHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            <Setter Property="Margin" Value="6,10,0,3" />
        </Style>

        <Style x:Key="Style.DetailLabel" TargetType="TextBlock" BasedOn="{StaticResource Style.FieldLabel}">
            <Setter Property="Margin" Value="0,8,0,2" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================ ШАПКА ============================ -->
        <Border Grid.Row="0" Style="{StaticResource Style.Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Style="{StaticResource Style.FieldLabel}" Text="КАТАЛОГ МОДОВ ИГРЫ" />
                    <TextBlock Style="{StaticResource Style.MonoValue}"
                               Text="{Binding ModsDir}"
                               ToolTip="{Binding ModsDir}"
                               Visibility="{Binding ModsDir, Converter={StaticResource StrToVis}}" />
                    <TextBlock Style="{StaticResource Style.Muted}" Margin="0,2,0,0" Text="{Binding Summary}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Style.Muted}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               Text="читаю каталог…"
                               Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />

                    <!-- Сетап из своих модов. Не пишет в игру, поэтому не гаснет при запущенной игре. -->
                    <Button x:Name="BuildSetupButton"
                            Style="{StaticResource Style.SmallButton}"
                            Margin="0,0,6,0"
                            Content="собрать сетап…"
                            Command="{Binding BuildSetupCommand}"
                            ToolTip="Упаковать свои моды в один Setup.exe: при установке в нём можно выбрать, какие моды ставить. В игру при этом ничего не пишется." />

                    <ToggleButton Style="{StaticResource Style.Chip}"
                                  Content="журнал"
                                  IsChecked="{Binding ShowJournal}"
                                  ToolTip="Что кокпит делал с файлами модов в этом сеансе. Те же строки дописываются в mods-operations.log рядом с settings.json." />

                    <Button Style="{StaticResource Style.SmallButton}"
                            Content="обновить"
                            Command="{Binding RefreshCommand}"
                            ToolTip="Перечитать каталог модов. Операция только читающая." />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================= БАННЕРЫ ======================= -->
        <StackPanel Grid.Row="1">
            <!-- Клиент обновился, а свои моды остались в каталоге прошлой версии. Кнопка открывает
                 окно перехода: проверка совместимости и перенос — только там и только по кнопке. -->
            <Border x:Name="MigrationBanner"
                    Background="{StaticResource Brush.PanelAlt}"
                    BorderBrush="{StaticResource Brush.Accent}"
                    BorderThickness="3,0,0,1"
                    Padding="10,6"
                    Visibility="{Binding HasPendingMigration, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="{Binding MigrationBannerText}"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource Brush.Text}" />
                    <Button x:Name="MigrationButton"
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource Style.SmallButton}"
                            Content="{Binding MigrationButtonText}"
                            Command="{Binding OpenMigrationCommand}" />
                </Grid>
            </Border>

            <!-- Запрет записи. Видно всегда, пока он действует: кнопки гаснут, и без этой
                 строки было бы непонятно, почему. -->
            <Border Background="{StaticResource Brush.WarnBg}"
                    BorderBrush="#FF5C5030"
                    BorderThickness="0,0,0,1"
                    Padding="10,6"
                    Visibility="{Binding WriteLockReason, Converter={StaticResource StrToVis}}">
                <TextBlock Text="{Binding WriteLockReason}"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource Brush.WarnText}" />
            </Border>

            <!-- Сложности обхода: недоступный подкаталог, битый архив. Список при этом
                 показывается целиком — скрыть существующий файл опаснее, чем показать его
                 без данных. -->
            <Border Background="{StaticResource Brush.PanelAlt}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="0,0,0,1"
                    Padding="10,5"
                    Visibility="{Binding ScanProblems, Converter={StaticResource StrToVis}}">
                <TextBlock Text="{Binding ScanProblems}"
                           TextWrapping="Wrap"
                           FontSize="11"
                           Foreground="{StaticResource Brush.TextMuted}" />
            </Border>
        </StackPanel>

        <!-- ============================ СПИСОК И ДЕТАЛИ ============================ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="{StaticResource Brush.Panel}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="0,0,0,1"
                        Padding="6,5">
                    <StackPanel>
                        <Grid>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{StaticResource Font.Mono}" />
                            <TextBlock Text="поиск: имя, id, имя файла"
                                       Margin="8,0,0,0"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="{StaticResource Brush.TextMuted}"
                                       Visibility="{Binding SearchText, Converter={StaticResource StrToVis}, ConverterParameter=invert}" />
                        </Grid>

                        <WrapPanel Margin="0,5,0,0">
                            <ToggleButton Style="{StaticResource Style.Chip}" Content="все" IsChecked="{Binding IsFilterAll}" />
                            <ToggleButton Style="{StaticResource Style.Chip}" Content="мои" IsChecked="{Binding IsFilterMine}" />
                            <ToggleButton Style="{StaticResource Style.Chip}" Content="чужие" IsChecked="{Binding IsFilterForeign}" />
                            <ToggleButton Style="{StaticResource Style.Chip}"
                                          Content="выключенные"
                                          IsChecked="{Binding IsFilterDisabled}"
                                          ToolTip="Выключенные моды не прячутся никогда: забытое выключение — частая причина «чиню то, чего нет»." />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1">
                    <ListBox x:Name="ModList"
                             ItemsSource="{Binding Mods}"
                             SelectedItem="{Binding Selected}"
                             ItemTemplate="{StaticResource ModRowTemplate}"
                             SelectionMode="Single"
                             HorizontalContentAlignment="Stretch"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <!-- ПРАВАЯ КНОПКА СНАЧАЛА ВЫДЕЛЯЕТ СТРОКУ, и это не придирка:
                             в WPF правый щелчок выделение НЕ меняет, а меню ниже
                             работает через Selected. Без этого «Открыть в VS Code»
                             открывало бы проект того мода, который был выбран
                             ДО щелчка, — и заметить это можно было бы не сразу. -->
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <EventSetter Event="PreviewMouseRightButtonDown"
                                             Handler="OnRowRightButtonDown" />
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <!-- Меню правой кнопки. Команда одна и та же, что у кнопки
                             «Открыть проект» справа: пункт гаснет сам, когда каталог
                             проекта неизвестен (чужой мод) — это решает CanOpenProject. -->
                        <ListBox.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="Открыть в VS Code"
                                          Command="{Binding OpenProjectCommand}" />
                                <MenuItem Header="Показать в проводнике"
                                          Command="{Binding RevealCommand}" />
                                <!-- Имя и описание меняются в src\meta.xml ПРОЕКТА — поэтому
                                     оба пункта гаснут у чужих модов, как «Открыть в VS Code».
                                     Новые пункты стоят ПОСЛЕ прежних: тест прозрачности
                                     недоступного пункта берёт первый пункт меню. -->
                                <Separator />
                                <MenuItem Header="Переименовать…"
                                          Command="{Binding RenameCommand}" />
                                <MenuItem Header="Изменить описание…"
                                          Command="{Binding EditDescriptionCommand}" />
                                <!-- Сборка проекта строки и установка через службу библиотеки,
                                     как «Поставить из dist». Гаснет у чужих модов, при
                                     запущенной игре и пока build.py занят. -->
                                <Separator />
                                <MenuItem Header="Собрать и установить"
                                          Command="{Binding BuildAndInstallCommand}"
                                          ToolTipService.ShowOnDisabled="True"
                                          ToolTip="build.py собирает проект в dist\, затем .mtmod ставится в игру после подтверждения; прежние версии выключаются (.mtmod.off). Недоступно при запущенной игре и пока идёт другая сборка." />
                            </ContextMenu>
                        </ListBox.ContextMenu>

                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource Style.GroupHeader}">
                                            <Run Text="{Binding Name, Mode=OneWay}" />
                                            <Run Text="{Binding ItemCount, Mode=OneWay, StringFormat=' ({0})'}"
                                                 FontWeight="Normal"
                                                 Foreground="{StaticResource Brush.TextMuted}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                    </ListBox>

                    <TextBlock Style="{StaticResource Style.EmptyState}"
                               FontSize="12"
                               Text="{Binding EmptyStateText}"
                               Visibility="{Binding Mods.Count, Converter={StaticResource CountToVis}, ConverterParameter=invert}" />
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

            <!-- ============================ ДЕТАЛИ ============================ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Style="{StaticResource Style.EmptyState}"
                           Text="Выберите мод слева.&#10;&#10;Здесь появятся полный путь, состав архива и действия.&#10;Действия бьют ровно по выбранной строке: галочек и массовых операций&#10;на этом экране нет намеренно — в каталоге лежат чужие моды."
                           Visibility="{Binding Selected, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />

                <!-- Карточка живёт в DataContext выбранной строки, поэтому внутри — короткие
                     привязки; видимость при этом берётся у модели экрана, а не у самой строки:
                     у пустого DataContext привязка вида {Binding} источника не имеет вовсе. -->
                <ScrollViewer Grid.Row="0"
                              VerticalScrollBarVisibility="Auto"
                              Padding="12,10"
                              DataContext="{Binding Selected}"
                              Visibility="{Binding DataContext.Selected, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NullToVis}}">
                    <StackPanel>
                        <!-- шапка карточки -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Width="50" Height="50" Margin="0,0,10,0" VerticalAlignment="Top">
                                <Border CornerRadius="8"
                                        Background="{Binding PlateBrush}"
                                        Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                    <TextBlock Text="{Binding PlateLetter}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="#FF15151A" />
                                </Border>
                                <Image Source="{Binding Icon}"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                            </Grid>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}"
                                           FontSize="15"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource Brush.Text}" />
                                <TextBlock Text="{Binding Subtitle}"
                                           FontSize="11"
                                           FontFamily="{StaticResource Font.Mono}"
                                           Foreground="{StaticResource Brush.TextMuted}" />
                                <TextBlock x:Name="CardState"
                                           Text="{Binding StateText}"
                                           Margin="0,3,0,0"
                                           FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.WarnText}" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <Border Grid.Column="2"
                                    Style="{StaticResource Style.OriginBadge}"
                                    VerticalAlignment="Top"
                                    BorderThickness="1"
                                    BorderBrush="{StaticResource Brush.TextMuted}">
                                <TextBlock Text="{Binding OriginBadge}"
                                           FontSize="10"
                                           Foreground="{StaticResource Brush.TextMuted}" />
                            </Border>
                        </Grid>

                        <!-- предупреждения -->
                        <Border Margin="0,10,0,0"
                                Padding="8,5"
                                CornerRadius="3"
                                Background="{StaticResource Brush.DangerBg}"
                                BorderBrush="#FF5E3230"
                                BorderThickness="1"
                                Visibility="{Binding DuplicateText, Converter={StaticResource StrToVis}}">
                            <TextBlock Text="{Binding DuplicateText}"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource Brush.DangerText}" />
                        </Border>

                        <Border Margin="0,10,0,0"
                                Padding="8,5"
                                CornerRadius="3"
                                Background="{StaticResource Brush.WarnBg}"
                                BorderBrush="#FF5C5030"
                                BorderThickness="1"
                                Visibility="{Binding HasNativeCode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding NativeText}"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource Brush.WarnText}" />
                        </Border>

                        <Border Margin="0,10,0,0"
                                Padding="8,5"
                                CornerRadius="3"
                                Background="{StaticResource Brush.WarnBg}"
                                BorderBrush="#FF5C5030"
                                BorderThickness="1"
                                Visibility="{Binding ArchiveStatusText, Converter={StaticResource StrToVis}}">
                            <TextBlock Text="{Binding ArchiveStatusText}"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource Brush.WarnText}" />
                        </Border>

                        <!-- Файл и состав архива — только у того, что лежит в игре. У проекта, которого
                             в игре нет, здесь были бы пустой путь, одинокое « · » и «meta.xml:
                             неизвестно — архив не прочитан», будто архив где-то есть. -->
                        <StackPanel x:Name="ArchiveDetails"
                                    Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                            <!-- файл -->
                            <TextBlock Style="{StaticResource Style.DetailLabel}" Text="ФАЙЛ" />
                            <TextBlock Text="{Binding FullPath}"
                                       FontFamily="{StaticResource Font.Mono}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource Brush.Text}" />
                            <TextBlock Style="{StaticResource Style.Muted}" Margin="0,3,0,0">
                                <Run Text="{Binding SizeText, Mode=OneWay}" />
                                <Run Text=" · " />
                                <Run Text="{Binding DateText, Mode=OneWay}" />
                            </TextBlock>

                            <!-- состав -->
                            <TextBlock Style="{StaticResource Style.DetailLabel}" Text="СОСТАВ" />
                            <TextBlock Style="{StaticResource Style.Muted}" Text="{Binding ContentText}" />
                            <TextBlock Style="{StaticResource Style.Muted}" Text="{Binding TypeText}" />
                            <TextBlock Style="{StaticResource Style.Muted}" Margin="0,2,0,0">
                                <Run Text="meta.xml: " />
                                <Run Text="{Binding MetaText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}"
                                   Margin="0,6,0,0"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource Brush.Text}"
                                   Visibility="{Binding Description, Converter={StaticResource StrToVis}}" />

                        <!-- Имя или описание в проекте уже новые, а в игре — старые. Так бывает
                             сразу после правки на этом экране: меняется src\meta.xml, а игра читает
                             архив. Строка списка честно показывает то, что стоит в игре. -->
                        <Border x:Name="ProjectMetaNoticeBox"
                                Margin="0,8,0,0"
                                Padding="8,5"
                                CornerRadius="3"
                                Background="{StaticResource Brush.WarnBg}"
                                BorderBrush="#FF5C5030"
                                BorderThickness="1"
                                Visibility="{Binding ProjectMetaNotice, Converter={StaticResource StrToVis}}">
                            <TextBlock Text="{Binding ProjectMetaNotice}"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource Brush.WarnText}" />
                        </Border>

                        <!-- сверка со сборкой проекта -->
                        <TextBlock Style="{StaticResource Style.DetailLabel}"
                                   Text="СБОРКА ПРОЕКТА"
                                   Visibility="{Binding IsMine, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding BuildMatchText}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource Brush.Text}"
                                   Visibility="{Binding IsMine, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding ProjectDir}"
                                   FontFamily="{StaticResource Font.Mono}"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0"
                                   Foreground="{StaticResource Brush.TextMuted}"
                                   Visibility="{Binding IsMine, Converter={StaticResource BoolToVis}}" />

                        <!-- Связь только по имени файла — повод сказать об этом вслух: у мода
                             без meta.xml это единственный признак, и он слабее совпадения id. -->
                        <TextBlock Style="{StaticResource Style.Muted}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource Brush.WarnText}"
                                   Text="Связь с проектом найдена только по имени файла (&lt;id&gt;_&lt;версия&gt;.mtmod): meta.xml в архиве нет или id в нём другой."
                                   Visibility="{Binding MatchedByFileNameOnly, Converter={StaticResource BoolToVis}}" />

                        <TextBlock Style="{StaticResource Style.Muted}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource Brush.WarnText}"
                                   Text="{Binding ProjectProblem}"
                                   Visibility="{Binding ProjectProblem, Converter={StaticResource StrToVis}}" />
                    </StackPanel>
                </ScrollViewer>

                <!-- ============================ ДЕЙСТВИЯ ============================ -->
                <Border Grid.Row="1"
                        Background="{StaticResource Brush.PanelAlt}"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="0,1,0,0"
                        Padding="10,8"
                        Visibility="{Binding Selected, Converter={StaticResource NullToVis}}">
                    <StackPanel>
                        <WrapPanel>
                            <Button Style="{StaticResource Style.WriteButton}"
                                    Content="Включить"
                                    Command="{Binding EnableCommand}"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Вернуть расширение .mtmod — игра снова увидит мод при следующем запуске"
                                    Visibility="{Binding Selected.ShowEnableAction, Converter={StaticResource BoolToVis}}" />

                            <Button Style="{StaticResource Style.WriteButton}"
                                    Content="Выключить"
                                    Command="{Binding DisableCommand}"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Переименовать в .mtmod.off. Файл остаётся на месте, включить обратно можно тут же."
                                    Visibility="{Binding Selected.ShowDisableAction, Converter={StaticResource BoolToVis}}" />

                            <Button Style="{StaticResource Style.ToolButton}"
                                    Content="Показать в проводнике"
                                    Command="{Binding RevealCommand}"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Открыть папку и выделить файл. Ничего не меняет."
                                    Visibility="{Binding Selected.IsInstalled, Converter={StaticResource BoolToVis}}" />

                            <Button Style="{StaticResource Style.ToolButton}"
                                    Content="Открыть проект"
                                    Command="{Binding OpenProjectCommand}"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Открыть каталог проекта в редакторе"
                                    Visibility="{Binding Selected.IsMine, Converter={StaticResource BoolToVis}}" />

                            <Button Style="{StaticResource Style.ToolButton}"
                                    Content="Имя и описание…"
                                    Command="{Binding RenameCommand}"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Поменять имя и описание в src\meta.xml проекта. В игре — после пересборки и установки."
                                    Visibility="{Binding Selected.IsMine, Converter={StaticResource BoolToVis}}" />

                            <Button Style="{StaticResource Style.WriteButton}"
                                    Command="{Binding InstallFromDistCommand}"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Скопировать собранный .mtmod из dist\ в каталог модов игры"
                                    Visibility="{Binding Selected.HasBuiltArtifact, Converter={StaticResource BoolToVis}}">
                                <TextBlock>
                                    <Run Text="Поставить из dist" />
                                    <Run Text="{Binding Selected.BuiltVersion, Mode=OneWay}" />
                                </TextBlock>
                            </Button>

                            <Button Style="{StaticResource Style.DangerButton}"
                                    Content="Удалить…"
                                    Command="{Binding DeleteCommand}"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Удалить файл навсегда. Два подтверждения, второе — ввод имени файла."
                                    Visibility="{Binding Selected.IsInstalled, Converter={StaticResource BoolToVis}}" />
                        </WrapPanel>

                        <TextBlock Style="{StaticResource Style.Muted}"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Text="Изменения вступают в силу при следующем запуске игры: моды читаются один раз при старте клиента." />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ============================ ЖУРНАЛ ============================ -->
        <Border Grid.Row="3"
                Background="{StaticResource Brush.Panel}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,1,0,0"
                MaxHeight="160"
                Visibility="{Binding ShowJournal, Converter={StaticResource BoolToVis}}">
            <Grid>
                <ListBox ItemsSource="{Binding Journal}"
                         Focusable="False"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       Margin="8,1"
                                       Style="{StaticResource Style.LogText}"
                                       Foreground="{StaticResource Brush.Text}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Style="{StaticResource Style.EmptyState}"
                           FontSize="11"
                           Text="В этом сеансе кокпит не менял ни одного файла модов."
                           Visibility="{Binding Journal.Count, Converter={StaticResource CountToVis}, ConverterParameter=invert}" />
            </Grid>
        </Border>

        <!-- ============================ СТРОКА СОСТОЯНИЯ ============================ -->
        <Border Grid.Row="4"
                Background="{StaticResource Brush.Panel}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,1,0,0"
                Padding="10,4">
            <TextBlock Style="{StaticResource Style.Muted}"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding StatusText}"
                       ToolTip="{Binding StatusText}" />
        </Border>
    </Grid>
</UserControl>
