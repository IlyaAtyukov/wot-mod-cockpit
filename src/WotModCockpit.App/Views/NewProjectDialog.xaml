<controls:ChromeWindow x:Class="WotModCockpit.App.Views.NewProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:WotModCockpit.App.Converters"
        xmlns:controls="clr-namespace:WotModCockpit.App.Controls"
        xmlns:stage3="clr-namespace:WotModCockpit.App.Stage3"
        xmlns:vm="clr-namespace:WotModCockpit.App.ViewModels"
        Title="Новый мод"
        Icon="/WotModCockpit.App;component/Resources/cockpit.ico"
        Height="680"
        Width="960"
        MinHeight="520"
        MinWidth="760"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <controls:ChromeWindow.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:StringToVisibilityConverter x:Key="StrToVis" />
        <conv:CountToVisibilityConverter x:Key="CountToVis" />
        <conv:ScaffoldActionToTextConverter x:Key="ActionToText" />

        <!-- Ошибка поля. Показывается ПОД полем и объясняет последствие, а не «неверный ввод»:
             у каждого правила здесь есть причина в устройстве загрузчика или build.py. -->
        <Style x:Key="Style.FieldError" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.DangerText}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <DataTemplate x:Key="PlanTemplate" DataType="{x:Type stage3:ScaffoldFileAction}">
            <Grid Margin="4,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding Kind, Converter={StaticResource ActionToText}}"
                           MinWidth="78"
                           Margin="0,0,8,0"
                           FontSize="10"
                           Foreground="{StaticResource Brush.TextMuted}" />

                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding RelativePath}"
                               FontFamily="{StaticResource Font.Mono}"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource Brush.Text}" />
                    <TextBlock Text="{Binding Note}"
                               FontSize="10"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource Brush.TextMuted}"
                               Visibility="{Binding Note, Converter={StaticResource StrToVis}}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SubstitutionTemplate" DataType="{x:Type vm:SubstitutionRow}">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="150" MaxWidth="230" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding Value}"
                           Margin="0,0,10,0"
                           FontFamily="{StaticResource Font.Mono}"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Value}"
                           Foreground="{StaticResource Brush.OkText}" />

                <TextBlock Grid.Column="1"
                           Text="{Binding Where}"
                           FontSize="10"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource Brush.TextMuted}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="IssueTemplate" DataType="{x:Type stage3:ScaffoldIssue}">
            <TextBlock x:Name="Text"
                       Text="{Binding Message}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,1"
                       Foreground="{StaticResource Brush.WarnText}" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Blocking}" Value="True">
                    <Setter TargetName="Text" Property="Foreground" Value="{StaticResource Brush.DangerText}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </controls:ChromeWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== ШАПКА ==================== -->
        <Border Grid.Row="0" Style="{StaticResource Style.Card}" Background="{StaticResource Brush.PanelAlt}">
            <StackPanel>
                <TextBlock Text="НОВЫЙ МОД ИЗ ШАБЛОНА" Style="{StaticResource Style.FieldLabel}" />
                <TextBlock TextWrapping="Wrap"
                           FontSize="11"
                           Foreground="{StaticResource Brush.Text}"
                           Text="Пять полей — двенадцать подстановок. Одно имя пакета живёт в шаблоне в трёх разных написаниях, тег лога — в двух, а маркер монкипатча обязан быть уникальным: два мода из одного шаблона с одинаковым маркером молча затирают логику друг друга." />

                <TextBlock Margin="0,6,0,0"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource Brush.DangerText}"
                           Text="{Binding UnavailableReason}"
                           Visibility="{Binding UnavailableReason, Converter={StaticResource StrToVis}}" />
            </StackPanel>
        </Border>

        <!-- ==================== ФОРМА И ПРЕДПРОСМОТР ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" MinWidth="320" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="12,10">
                <StackPanel>
                    <TextBlock Text="ИМЯ МОДА" Style="{StaticResource Style.FieldLabel}" />
                    <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Style.Muted}"
                               Margin="0,2,0,0"
                               Text="попадёт в meta.xml &lt;name&gt;; из него выводится всё остальное" />
                    <TextBlock Style="{StaticResource Style.FieldError}"
                               Text="{Binding DisplayNameError}"
                               Visibility="{Binding DisplayNameError, Converter={StaticResource StrToVis}}" />

                    <TextBlock Text="ИМЯ ПАКЕТА" Style="{StaticResource Style.FieldLabel}" Margin="0,12,0,2" />
                    <TextBox Text="{Binding Package, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="{StaticResource Font.Mono}" />
                    <TextBlock Style="{StaticResource Style.Muted}"
                               Margin="0,2,0,0"
                               TextWrapping="Wrap"
                               Text="каталог тела мода и имя точки входа mod_&lt;пакет&gt;.py; только строчная латиница, цифры и подчёркивание" />
                    <TextBlock Style="{StaticResource Style.FieldError}"
                               Text="{Binding PackageError}"
                               Visibility="{Binding PackageError, Converter={StaticResource StrToVis}}" />

                    <TextBlock Text="ИДЕНТИФИКАТОР МОДА" Style="{StaticResource Style.FieldLabel}" Margin="0,12,0,2" />
                    <TextBox Text="{Binding ModId, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="{StaticResource Font.Mono}" />
                    <TextBlock Style="{StaticResource Style.Muted}"
                               Margin="0,2,0,0"
                               Text="meta.xml &lt;id&gt;; build.py делает из него имя &lt;id&gt;_&lt;версия&gt;.mtmod" />
                    <TextBlock Style="{StaticResource Style.Muted}"
                               Margin="0,2,0,0"
                               TextWrapping="Wrap"
                               Text="{Binding ModIdHint, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource Style.FieldError}"
                               Text="{Binding ModIdError}"
                               Visibility="{Binding ModIdError, Converter={StaticResource StrToVis}}" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="ВЕРСИЯ" Style="{StaticResource Style.FieldLabel}" />
                            <TextBox Text="{Binding Version, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{StaticResource Font.Mono}" />
                            <TextBlock Style="{StaticResource Style.FieldError}"
                                       Text="{Binding VersionError}"
                                       Visibility="{Binding VersionError, Converter={StaticResource StrToVis}}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="ТЕГ ЛОГА" Style="{StaticResource Style.FieldLabel}" />
                            <TextBox Text="{Binding LogTag, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{StaticResource Font.Mono}" />
                            <TextBlock Style="{StaticResource Style.FieldError}"
                                       Text="{Binding LogTagError}"
                                       Visibility="{Binding LogTagError, Converter={StaticResource StrToVis}}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Style.Muted}"
                               Margin="0,2,0,0"
                               TextWrapping="Wrap"
                               Text="тег лога станет [Тег] в теле мода и [Тег/loader] в стабе — по нему фильтруется живой python.log" />

                    <TextBlock Text="ОПИСАНИЕ" Style="{StaticResource Style.FieldLabel}" Margin="0,12,0,2" />
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="46"
                             VerticalContentAlignment="Top" />

                    <TextBlock Text="СОЗДАТЬ ВНУТРИ КАТАЛОГА" Style="{StaticResource Style.FieldLabel}" Margin="0,12,0,2" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding ParentDir, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="{StaticResource Font.Mono}"
                                 FontSize="11" />
                        <Button Grid.Column="1"
                                Style="{StaticResource Style.SmallButton}"
                                Margin="6,0,0,0"
                                Content="выбрать…"
                                Command="{Binding BrowseParentCommand}" />
                    </Grid>
                    <TextBlock Style="{StaticResource Style.FieldError}"
                               Text="{Binding ParentDirError}"
                               Visibility="{Binding ParentDirError, Converter={StaticResource StrToVis}}" />

                    <TextBlock Text="ШАБЛОН" Style="{StaticResource Style.FieldLabel}" Margin="0,12,0,2" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding TemplateDir, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="{StaticResource Font.Mono}"
                                 FontSize="11" />
                        <Button Grid.Column="1"
                                Style="{StaticResource Style.SmallButton}"
                                Margin="6,0,0,0"
                                Content="выбрать…"
                                Command="{Binding BrowseTemplateCommand}" />
                    </Grid>
                    <TextBlock Style="{StaticResource Style.FieldError}"
                               Text="{Binding TemplateDirError}"
                               Visibility="{Binding TemplateDirError, Converter={StaticResource StrToVis}}" />
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

            <ScrollViewer Grid.Column="2"
                          Background="{StaticResource Brush.Panel}"
                          VerticalScrollBarVisibility="Auto"
                          Padding="12,10">
                <StackPanel>
                    <TextBlock Text="БУДЕТ СОЗДАН КАТАЛОГ" Style="{StaticResource Style.FieldLabel}" />
                    <TextBlock Text="{Binding TargetDir}"
                               FontFamily="{StaticResource Font.Mono}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource Brush.Text}" />

                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="точка входа:" Style="{StaticResource Style.Muted}" />
                        <TextBlock Text="{Binding EntryPointFile}"
                                   Margin="6,0,0,0"
                                   FontFamily="{StaticResource Font.Mono}"
                                   FontSize="11"
                                   Foreground="{StaticResource Brush.OkText}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="артефакт сборки:" Style="{StaticResource Style.Muted}" />
                        <TextBlock Text="{Binding ArtifactName}"
                                   Margin="6,0,0,0"
                                   FontFamily="{StaticResource Font.Mono}"
                                   FontSize="11"
                                   Foreground="{StaticResource Brush.OkText}" />
                    </StackPanel>

                    <TextBlock Text="ЧТО КУДА ПОДСТАВИТСЯ" Style="{StaticResource Style.FieldLabel}" Margin="0,14,0,2" />
                    <ItemsControl ItemsSource="{Binding Substitutions}"
                                  ItemTemplate="{StaticResource SubstitutionTemplate}" />

                    <TextBlock Text="ЗАМЕЧАНИЯ МАСТЕРА" Style="{StaticResource Style.FieldLabel}" Margin="0,14,0,2"
                               Visibility="{Binding BackendIssues.Count, Converter={StaticResource CountToVis}}" />
                    <ItemsControl ItemsSource="{Binding BackendIssues}"
                                  ItemTemplate="{StaticResource IssueTemplate}" />

                    <TextBlock Text="ЧТО БУДЕТ СОЗДАНО" Style="{StaticResource Style.FieldLabel}" Margin="0,14,0,2" />
                    <TextBlock Text="{Binding PlanStatus}" Style="{StaticResource Style.Muted}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding PlanFiles}"
                                  ItemTemplate="{StaticResource PlanTemplate}"
                                  Margin="0,4,0,0" />

                    <TextBlock Text="ЖУРНАЛ СОЗДАНИЯ" Style="{StaticResource Style.FieldLabel}" Margin="0,14,0,2"
                               Visibility="{Binding CreateLog.Count, Converter={StaticResource CountToVis}}" />
                    <ItemsControl ItemsSource="{Binding CreateLog}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           FontFamily="{StaticResource Font.Mono}"
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource Brush.TextMuted}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ==================== НИЗ ==================== -->
        <Border Grid.Row="2"
                Background="{StaticResource Brush.Panel}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,1,0,0"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ProgressBar Width="110"
                                 Height="6"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Style="{StaticResource Style.Muted}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding StatusText}"
                               ToolTip="{Binding StatusText}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource Style.ToolButton}"
                            Content="Создать"
                            Command="{Binding CreateCommand}"
                            IsDefault="True" />
                    <Button Style="{StaticResource Style.ToolButton}"
                            Margin="0"
                            Content="Отмена"
                            Command="{Binding CancelCommand}"
                            IsCancel="True" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</controls:ChromeWindow>
