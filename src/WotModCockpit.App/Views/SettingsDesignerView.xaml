<UserControl x:Class="WotModCockpit.App.Views.SettingsDesignerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WotModCockpit.App.Controls"
             xmlns:conv="clr-namespace:WotModCockpit.App.Converters"
             xmlns:vm="clr-namespace:WotModCockpit.App.ViewModels"
             Background="{StaticResource Brush.Window}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Редакторы свойств по типам контролов: одиннадцать шаблонов с ключами
                     Editor.CheckBox, Editor.Slider и так далее. -->
                <ResourceDictionary Source="/WotModCockpit.App;component/Views/DataTemplates/ControlEditors.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:StringToVisibilityConverter x:Key="StrToVis" />
            <conv:CountToVisibilityConverter x:Key="CountToVis" />
            <conv:SettingsIssueToBrushConverter x:Key="IssueBrush" />

            <controls:SettingsTemplateSelector x:Key="EditorSelector" Prefix="Editor." />

            <!-- Единственный ComboBox-содержащий экран, кроме рецептов: стиль живёт здесь,
                 чтобы не менять вид всего приложения ради одного экрана. -->
            <Style TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="6,3" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#FF2D3D4B" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ComboBox">
                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                <Setter Property="Background" Value="#FF17171A" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="6,3" />
                <Setter Property="MinHeight" Value="24" />
                <Setter Property="MaxDropDownHeight" Value="320" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton Focusable="False"
                                              ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Bd"
                                                    Background="#FF17171A"
                                                    BorderBrush="{StaticResource Brush.Border}"
                                                    BorderThickness="1"
                                                    CornerRadius="3">
                                                <Path HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,7,0"
                                                      Data="M0,0 L8,0 L4,5 Z"
                                                      Fill="{StaticResource Brush.TextMuted}" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#FF4C4C55" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <ContentPresenter Margin="7,0,20,0"
                                                  IsHitTestVisible="False"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />

                                <Popup x:Name="PART_Popup"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       Placement="Bottom"
                                       IsOpen="{TemplateBinding IsDropDownOpen}">
                                    <Border MinWidth="{TemplateBinding ActualWidth}"
                                            MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                            Background="{StaticResource Brush.PanelAlt}"
                                            BorderBrush="{StaticResource Brush.Border}"
                                            BorderThickness="1">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Строка палитры. -->
            <DataTemplate x:Key="PaletteItemTemplate" DataType="{x:Type vm:SettingsPaletteItem}">
                <Grid Margin="6,4" ToolTip="{Binding ToolTipText}" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Title}" FontSize="12" Foreground="{StaticResource Brush.Text}" />
                        <TextBlock Text="{Binding TypeName}"
                                   FontSize="9"
                                   FontFamily="{StaticResource Font.Mono}"
                                   Foreground="{StaticResource Brush.TextMuted}" />
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="{Binding LiveBadge}"
                               VerticalAlignment="Center"
                               Margin="6,0,0,0"
                               FontSize="9"
                               Foreground="{StaticResource Brush.TextMuted}" />
                </Grid>
            </DataTemplate>

            <!-- Строка списка замечаний. -->
            <DataTemplate x:Key="IssueTemplate" DataType="{x:Type vm:SettingsDesignerIssue}">
                <Grid Margin="6,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding Badge}"
                               MinWidth="60"
                               FontSize="10"
                               VerticalAlignment="Top"
                               Foreground="{Binding Severity, Converter={StaticResource IssueBrush}}" />

                    <TextBlock Grid.Column="1"
                               Text="{Binding Where}"
                               MinWidth="150"
                               Margin="0,0,8,0"
                               FontSize="10"
                               VerticalAlignment="Top"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource Brush.TextMuted}" />

                    <TextBlock Grid.Column="2"
                               Text="{Binding Message}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource Brush.Text}" />
                </Grid>
            </DataTemplate>

            <!-- Строка файла предпросмотра. -->
            <DataTemplate x:Key="ArtifactTemplate" DataType="{x:Type vm:GeneratedArtifactViewModel}">
                <StackPanel Margin="6,4">
                    <TextBlock Text="{Binding Title}"
                               FontSize="11"
                               FontFamily="{StaticResource Font.Mono}"
                               Foreground="{StaticResource Brush.Text}" />
                    <TextBlock Text="{Binding Action}"
                               FontSize="9"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource Brush.TextMuted}" />
                </StackPanel>
            </DataTemplate>

            <!-- Строка чужого шаблона из modsettings.dat. -->
            <DataTemplate x:Key="LiveTemplateTemplate">
                <StackPanel Margin="6,4">
                    <TextBlock Text="{Binding DisplayName}" FontSize="12" Foreground="{StaticResource Brush.Text}" />
                    <TextBlock Text="{Binding Display}"
                               FontSize="9"
                               FontFamily="{StaticResource Font.Mono}"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource Brush.TextMuted}" />
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ШАПКА: свойства шаблона -->
        <Border Grid.Row="0"
                Background="{StaticResource Brush.Panel}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,0,0,1"
                Padding="10,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="140" />
                    <ColumnDefinition Width="2*" MinWidth="140" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Заголовок блока в окне · modDisplayName" Style="{StaticResource Style.FieldLabel}" />
                    <TextBox Text="{Binding ModDisplayName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="Ключ мода · linkage (менять нельзя после выпуска)"
                               Style="{StaticResource Style.FieldLabel}" />
                    <TextBox Text="{Binding Linkage, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="{StaticResource Font.Mono}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="settingsVersion" Style="{StaticResource Style.FieldLabel}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox Text="{Binding SettingsVersionText, UpdateSourceTrigger=PropertyChanged}"
                                 Width="52"
                                 FontFamily="{StaticResource Font.Mono}" />
                        <Button Style="{StaticResource Style.SmallButton}"
                                Content="+1"
                                Margin="4,0,0,0"
                                Command="{Binding BumpVersionCommand}"
                                ToolTip="Поднять версию состава формы.&#10;Пока версия не поднята, ModsSettingsAPI показывает игроку СТАРУЮ форму.&#10;После поднятия значения игрока сбрасываются к умолчаниям шаблона." />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="0,0,10,0">
                    <TextBlock Text="тумблер мода" Style="{StaticResource Style.FieldLabel}" />
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton Style="{StaticResource Style.Chip}"
                                      Content="enabled"
                                      IsChecked="{Binding HasEnabled, Mode=TwoWay}"
                                      ToolTip="Есть ключ enabled — над блоком мода появляется тумблер вкл/выкл,&#10;и в настройках появляется ключ 'enabled'.&#10;Тумблер гасит контролы только ВИЗУАЛЬНО: логику выключения мод реализует сам." />
                        <ToggleButton Style="{StaticResource Style.Chip}"
                                      Content="вкл. по умолчанию"
                                      Margin="4,0,0,0"
                                      IsEnabled="{Binding HasEnabled}"
                                      IsChecked="{Binding EnabledDefault, Mode=TwoWay}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TargetHint}"
                               FontSize="10"
                               FontFamily="{StaticResource Font.Mono}"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource Brush.TextMuted}"
                               ToolTip="{Binding TargetHint}" />
                    <TextBlock Text="{Binding UnavailableReason}"
                               FontSize="10"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource Brush.WarnText}"
                               Visibility="{Binding UnavailableReason, Converter={StaticResource StrToVis}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ТЕЛО: палитра · превью · свойства -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" MinWidth="170" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="330" MinWidth="240" />
            </Grid.ColumnDefinitions>

            <!-- ЛЕВО: палитра -->
            <Grid Grid.Column="0" Background="{StaticResource Brush.Panel}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="0,0,0,1"
                        Padding="8,6">
                    <StackPanel>
                        <TextBlock Text="Палитра контролов" FontWeight="Bold" FontSize="11" />
                        <TextBlock Text="перетащите в колонку или щёлкните дважды"
                                   FontSize="9"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource Brush.TextMuted}" />
                    </StackPanel>
                </Border>

                <ListBox x:Name="PaletteList"
                         Grid.Row="1"
                         ItemsSource="{Binding Palette}"
                         ItemTemplate="{StaticResource PaletteItemTemplate}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         PreviewMouseLeftButtonDown="OnPaletteMouseDown"
                         PreviewMouseMove="OnPaletteMouseMove"
                         MouseDoubleClick="OnPaletteDoubleClick" />

                <Border Grid.Row="2"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="0,1,0,0"
                        Padding="8,6">
                    <TextBlock TextWrapping="Wrap" FontSize="9" Foreground="{StaticResource Brush.TextMuted}">
                        <Run Text="Число у типа — сколько раз он встретился в выборке из 13 реальных шаблонов популярных модов, на которых проверялся кокпит (клиент 1.44), а не в модах на этой машине." />
                        <Run Text="Тип без образцов восстановлен по коду ModsSettingsAPI и в бою не проверен." />
                    </TextBlock>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" />

            <!-- ЦЕНТР: превью формы -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource Brush.Panel}"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="0,0,0,1"
                        Padding="8,5">
                    <Grid>
                        <TextBlock VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource Brush.TextMuted}">
                            <Run Text="СХЕМА окна настроек: раскладка настоящая (блок 900 px, колонка 430, отступ 10)," />
                            <Run Text="но шрифты и скины окно берёт из клиента — пиксель-в-пиксель офлайн невозможен." />
                        </TextBlock>

                        <ToggleButton Style="{StaticResource Style.Chip}"
                                      HorizontalAlignment="Right"
                                      Content="уместить"
                                      IsChecked="{Binding FitPreview, Mode=TwoWay}"
                                      ToolTip="Ужать схему по ширине панели. Снятая галочка показывает её 1:1 с прокруткой." />
                    </Grid>
                </Border>

                <controls:SettingsPreview Grid.Row="1" />

                <!-- Пустое состояние: закрывает превью целиком, пока в форме ничего нет. -->
                <Border Grid.Row="1"
                        Background="{StaticResource Brush.Window}"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="620" Margin="24">
                            <TextBlock Text="Настройки мода через ModsSettingsAPI"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Margin="0,0,0,10" />

                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{StaticResource Brush.Text}">
                                <Run Text="Штатного окна настроек у модов «Мира танков» нет. То, что игроки называют" />
                                <Run Text="настройками мода, рисует ЧУЖОЙ мод — izeberg.modssettingsapi: он собирает" />
                                <Run Text="блок из ваших галочек и ползунков по декларативному шаблону-словарю." />
                            </TextBlock>

                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{StaticResource Brush.TextMuted}">
                                <Run Text="Значит, у игрока вашего мода он должен быть УСТАНОВЛЕН. Кокпит генерирует код так," />
                                <Run Text="что без него мод продолжает работать на своих значениях из JSON-конфига, а окно" />
                                <Run Text="настроек просто недоступно: импорт обёрнут в try/except ImportError (правило WOT018)." />
                            </TextBlock>

                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,14" Foreground="{StaticResource Brush.TextMuted}">
                                <Run Text="Главная ловушка, о которой стоит знать заранее: API НИКОГДА не сливает старые" />
                                <Run Text="значения игрока в новый шаблон. Любая правка, которая до него доезжает," />
                                <Run Text="сбрасывает настройки к умолчаниям. Поэтому сгенерированный код строит шаблон" />
                                <Run Text="ОТ СОХРАНЁННЫХ значений — тогда сброс возвращает игрока к его же выбору." />
                            </TextBlock>

                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource Style.ToolButton}"
                                        Content="Начать с типовой формы"
                                        Command="{Binding StartTypicalFormCommand}"
                                        ToolTip="Одна галочка «показывать сообщение» и тумблер мода — дальше проще дополнять, чем начинать с нуля" />
                                <Button Style="{StaticResource Style.ToolButton}"
                                        Content="Посмотреть чужие формы"
                                        Command="{Binding OpenLiveImportCommand}"
                                        ToolTip="Прочитать шаблоны установленных модов из modsettings.dat. Только чтение." />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Панель импорта из живого состояния. -->
                <Border Grid.Row="1"
                        Background="{StaticResource Brush.Window}"
                        Visibility="{Binding ShowImport, Converter={StaticResource BoolToVis}}">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="Шаблоны установленных модов" FontWeight="Bold" />
                            <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource Brush.WarnText}">
                                <Run Text="Это НАСТРОЙКИ ИГРОКА для чужих модов. Кокпит открыл файл на чтение" />
                                <Run Text="и ничего в нём не менял и не изменит." />
                            </TextBlock>
                            <TextBlock Text="{Binding LivePath}"
                                       FontSize="9"
                                       FontFamily="{StaticResource Font.Mono}"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource Brush.TextMuted}" />
                            <TextBlock Text="{Binding LiveError}"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource Brush.DangerText}"
                                       Visibility="{Binding LiveError, Converter={StaticResource StrToVis}}" />
                        </StackPanel>

                        <Border Grid.Row="1"
                                Background="{StaticResource Brush.Panel}"
                                BorderBrush="{StaticResource Brush.Border}"
                                BorderThickness="1">
                            <ListBox ItemsSource="{Binding LiveTemplates}"
                                     SelectedItem="{Binding SelectedLiveTemplate, Mode=TwoWay}"
                                     ItemTemplate="{StaticResource LiveTemplateTemplate}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        </Border>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Style="{StaticResource Style.ToolButton}"
                                    Content="Загрузить в дизайнер"
                                    Command="{Binding ImportFromLiveCommand}" />
                            <Button Style="{StaticResource Style.ToolButton}"
                                    Content="Закрыть"
                                    Click="OnCloseImport" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Предпросмотр того, что будет записано. -->
                <Grid Grid.Row="2"
                      Height="280"
                      Visibility="{Binding ShowCode, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.ColumnSpan="2"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="0,1,0,0"
                            Background="{StaticResource Brush.Panel}" />

                    <!-- Заголовок панели он же предупреждение: форму правили после сборки,
                         значит показанный код уже не отвечает экрану. -->
                    <TextBlock x:Name="CodeHeaderText"
                               Grid.Row="0"
                               Grid.ColumnSpan="2"
                               Text="{Binding CodeHeader}"
                               Margin="8,5,8,3"
                               FontSize="10"
                               FontWeight="Bold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource Brush.TextMuted}" />

                    <Grid Grid.Row="1" Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ListBox Grid.Row="0"
                                 ItemsSource="{Binding Artifacts}"
                                 SelectedItem="{Binding SelectedArtifact, Mode=TwoWay}"
                                 ItemTemplate="{StaticResource ArtifactTemplate}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />

                        <StackPanel Grid.Row="1" Margin="6,4">
                            <TextBlock Text="{Binding SelectedArtifact.RelativePath}"
                                       FontSize="9"
                                       FontFamily="{StaticResource Font.Mono}"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource Brush.TextMuted}" />
                            <TextBlock Text="{Binding SelectedArtifact.Note}"
                                       FontSize="9"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0"
                                       Foreground="{StaticResource Brush.TextMuted}" />
                        </StackPanel>
                    </Grid>

                    <controls:PythonSourceView Grid.Row="1"
                                               Grid.Column="1"
                                               SourceText="{Binding SelectedArtifact.Content}"
                                               EmptyText="Нажмите «сгенерировать код»." />
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" />

            <!-- ПРАВО: свойства выбранного контрола -->
            <Grid Grid.Column="4" Background="{StaticResource Brush.Panel}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="0,0,0,1"
                        Padding="8,6">
                    <StackPanel>
                        <TextBlock Text="Свойства контрола" FontWeight="Bold" FontSize="11" />
                        <TextBlock Text="{Binding Selected.TypeDisplay}"
                                   FontSize="12"
                                   Foreground="{StaticResource Brush.Text}"
                                   Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding Selected.TypeSummary}"
                                   FontSize="9"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource Brush.TextMuted}"
                                   Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="в живых шаблонах такого контрола нет — тип восстановлен по коду API"
                                   FontSize="9"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0"
                                   Foreground="{StaticResource Brush.WarnText}"
                                   Visibility="{Binding Selected.IsUnproven, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed, TargetNullValue=Collapsed}" />
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8,8,8,8">
                    <StackPanel>
                        <ContentControl Content="{Binding Selected}"
                                        ContentTemplateSelector="{StaticResource EditorSelector}" />

                        <Border Background="{StaticResource Brush.DangerBg}"
                                BorderBrush="{StaticResource Brush.Danger}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="6,4"
                                Margin="0,4,0,0"
                                Visibility="{Binding Selected.HasError, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
                            <TextBlock Text="{Binding Selected.ErrorText}"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource Brush.DangerText}" />
                        </Border>

                        <Border Background="{StaticResource Brush.WarnBg}"
                                BorderBrush="#FF5C5030"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="6,4"
                                Margin="0,4,0,0"
                                Visibility="{Binding Selected.HasWarning, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
                            <TextBlock Text="{Binding Selected.WarningText}"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource Brush.WarnText}" />
                        </Border>

                        <TextBlock Style="{StaticResource Style.EmptyState}"
                                   Text="Контрол не выбран. Добавьте его из палитры слева или щёлкните по нему в схеме окна."
                                   Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="0,1,0,0"
                        Padding="6,6">
                    <WrapPanel>
                        <Button Style="{StaticResource Style.SmallButton}"
                                Content="вверх"
                                Margin="0,0,4,4"
                                Command="{Binding MoveUpCommand}" />
                        <Button Style="{StaticResource Style.SmallButton}"
                                Content="вниз"
                                Margin="0,0,4,4"
                                Command="{Binding MoveDownCommand}" />
                        <Button Style="{StaticResource Style.SmallButton}"
                                Content="в другую колонку"
                                Margin="0,0,4,4"
                                Command="{Binding SwapColumnCommand}" />
                        <Button Style="{StaticResource Style.SmallButton}"
                                Content="дублировать"
                                Margin="0,0,4,4"
                                Command="{Binding DuplicateSelectedCommand}" />
                        <Button Style="{StaticResource Style.SmallButton}"
                                Content="удалить"
                                Margin="0,0,4,4"
                                Command="{Binding RemoveSelectedCommand}" />
                    </WrapPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ЗАМЕЧАНИЯ -->
        <Border Grid.Row="2"
                Background="{StaticResource Brush.Panel}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,1,0,0"
                MaxHeight="150"
                Visibility="{Binding Issues.Count, Converter={StaticResource CountToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{Binding IssuesHeader}"
                           Margin="8,4,0,2"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{StaticResource Brush.TextMuted}" />

                <ListBox x:Name="IssueList"
                         Grid.Row="1"
                         ItemsSource="{Binding Issues}"
                         ItemTemplate="{StaticResource IssueTemplate}"
                         SelectionChanged="OnIssueSelected"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </Grid>
        </Border>

        <!-- НИЗ: действия -->
        <Border Grid.Row="3"
                Background="{StaticResource Brush.PanelAlt}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,1,0,0"
                Padding="10,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Style="{StaticResource Style.ToolButton}"
                            Content="Сгенерировать код"
                            Command="{Binding GenerateCodeCommand}"
                            ToolTip="Собрать settings_schema.py, settings.py и settings.design.json и показать их.&#10;Ничего не записывается." />
                    <Button Style="{StaticResource Style.WriteButton}"
                            Content="Записать в проект"
                            Command="{Binding WriteFilesCommand}"
                            ToolTip="Записать показанные файлы в каталог проекта.&#10;Существующие копируются рядом с расширением .bak." />
                    <Button Style="{StaticResource Style.ToolButton}"
                            Content="JSON шаблона"
                            Command="{Binding ShowTemplateJsonCommand}"
                            ToolTip="Показать шаблон в том виде, в каком он ляжет в modsettings.dat" />
                    <Button Style="{StaticResource Style.ToolButton}"
                            Content="Импорт из проекта"
                            Command="{Binding ImportFromProjectCommand}"
                            ToolTip="Прочитать форму из settings.design.json проекта" />
                    <Button Style="{StaticResource Style.ToolButton}"
                            Content="Импорт из игры…"
                            Command="{Binding OpenLiveImportCommand}"
                            ToolTip="Прочитать шаблоны установленных модов из modsettings.dat. Только чтение." />
                    <Button Style="{StaticResource Style.SmallButton}"
                            Content="в VS Code"
                            Margin="0,0,6,0"
                            Command="{Binding OpenArtifactCommand}" />
                    <Button Style="{StaticResource Style.SmallButton}"
                            Content="копировать"
                            Margin="0,0,6,0"
                            Command="{Binding CopyArtifactCommand}" />
                    <Button Style="{StaticResource Style.SmallButton}"
                            Content="очистить форму"
                            Command="{Binding ClearFormCommand}" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding StatusText}"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource Brush.TextMuted}"
                           ToolTip="{Binding StatusText}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
