<controls:ChromeWindow x:Class="WotModCockpit.App.Views.MetaEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:WotModCockpit.App.Converters"
        xmlns:controls="clr-namespace:WotModCockpit.App.Controls"
        Title="Имя и описание мода"
        Icon="/WotModCockpit.App;component/Resources/cockpit.ico"
        Width="600"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <!--
        ДИАЛОГ ПРАВКИ ИМЕНИ И ОПИСАНИЯ МОДА.

        Меняется ТОЛЬКО src\meta.xml проекта. В установленный архив кокпит не пишет — это
        правило всего экрана «Моды»: игра меняется только сборкой и установкой. Поэтому внизу
        окна прямо сказано, когда новое имя появится в игре.

        Ctrl+Enter сохраняет из любого поля: в поле описания Enter переводит строку, и без
        этого с клавиатуры сохранить было бы нечем.
    -->

    <controls:ChromeWindow.InputBindings>
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding SaveCommand}" />
    </controls:ChromeWindow.InputBindings>

    <controls:ChromeWindow.Resources>
        <conv:StringToVisibilityConverter x:Key="StrToVis" />

        <!-- Ошибка поля — под полем, и объясняет последствие, а не «неверный ввод». -->
        <Style x:Key="Style.FieldError" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.DangerText}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>

        <Style x:Key="Style.FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
    </controls:ChromeWindow.Resources>

    <StackPanel Margin="18,12,18,16">
        <TextBlock FontSize="11" Foreground="{StaticResource Brush.TextMuted}" TextWrapping="Wrap">
            <Run Text="мод " />
            <Run Text="{Binding ModId, Mode=OneWay}" FontFamily="{StaticResource Font.Mono}" Foreground="{StaticResource Brush.Text}" />
        </TextBlock>

        <TextBlock Style="{StaticResource Style.FieldLabel}" Text="ИМЯ" />
        <TextBox x:Name="NameBox"
                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                 MaxLength="{Binding MaxNameLength, Mode=OneTime}" />
        <TextBlock Style="{StaticResource Style.FieldError}"
                   Text="{Binding NameError}"
                   Visibility="{Binding NameError, Converter={StaticResource StrToVis}}" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource Style.FieldLabel}" Text="ОПИСАНИЕ" />
            <TextBlock Grid.Column="1"
                       Style="{StaticResource Style.FieldLabel}"
                       Text="{Binding DescriptionCounter}" />
        </Grid>
        <TextBox x:Name="DescriptionBox"
                 Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                 MaxLength="{Binding MaxDescriptionLength, Mode=OneTime}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 Height="120"
                 VerticalContentAlignment="Top"
                 VerticalScrollBarVisibility="Auto" />
        <TextBlock Style="{StaticResource Style.FieldError}"
                   Text="{Binding DescriptionError}"
                   Visibility="{Binding DescriptionError, Converter={StaticResource StrToVis}}" />

        <TextBlock Margin="0,14,0,0"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource Brush.TextMuted}">
            <Run Text="Меняется файл" />
            <Run Text="{Binding MetaPath, Mode=OneWay}" FontFamily="{StaticResource Font.Mono}" />
            <LineBreak />
            <Run Text="В игре имя и описание сменятся после пересборки мода и установки. Ctrl+Enter — сохранить." />
        </TextBlock>

        <StackPanel Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SaveButton"
                    Content="Сохранить"
                    MinWidth="110"
                    Margin="0,0,8,0"
                    Command="{Binding SaveCommand}"
                    IsDefault="True" />
            <Button x:Name="CancelButton"
                    Content="Отмена"
                    MinWidth="90"
                    Command="{Binding CancelCommand}"
                    IsCancel="True" />
        </StackPanel>
    </StackPanel>
</controls:ChromeWindow>
