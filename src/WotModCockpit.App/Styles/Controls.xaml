<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Именованные стили кокпита. Базовые (безымянные) лежат в DarkTheme.xaml
         и обязаны быть подключены РАНЬШЕ этого словаря. -->

    <!-- Кнопка тулбара: чуть просторнее обычной. -->
    <Style x:Key="Style.ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="Margin" Value="0,0,6,0" />
    </Style>

    <!-- Кнопка тулбара, которая ПИШЕТ В ИГРУ. Подсвечена, чтобы её нельзя было нажать вслепую. -->
    <Style x:Key="Style.WriteButton" TargetType="Button" BasedOn="{StaticResource Style.ToolButton}">
        <Setter Property="Background" Value="#FF2E2A1C" />
        <Setter Property="BorderBrush" Value="#FF5C5030" />
        <Setter Property="Foreground" Value="#FFE8C275" />
    </Style>

    <!-- Кнопка удаления из игры. -->
    <Style x:Key="Style.DangerButton" TargetType="Button" BasedOn="{StaticResource Style.ToolButton}">
        <Setter Property="Background" Value="#FF33201F" />
        <Setter Property="BorderBrush" Value="#FF5E3230" />
        <Setter Property="Foreground" Value="#FFFF9A96" />
    </Style>

    <!-- Мелкая кнопка (обновить, очистить, выбрать папку). -->
    <Style x:Key="Style.SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="MinWidth" Value="0" />
    </Style>

    <!-- Ссылка: кадр traceback, путь к файлу. -->
    <Style x:Key="Style.LinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="#FF6FB3E0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="#FF9BD1F5" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Тумблер-«чип» в панели лога. -->
    <Style x:Key="Style.Chip" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- Карточка-панель (шапка, состояние деплоя, панель сборки). -->
    <Style x:Key="Style.Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Panel}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="10,8" />
    </Style>

    <!-- Подпись поля в шапке. -->
    <Style x:Key="Style.FieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <Style x:Key="Style.FieldValue" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Style.MonoValue" TargetType="TextBlock" BasedOn="{StaticResource Style.FieldValue}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    </Style>

    <Style x:Key="Style.Muted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- Пустое состояние: «проект не выбран», «python.log пока пуст». -->
    <Style x:Key="Style.EmptyState" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxWidth" Value="520" />
    </Style>

    <!-- Строка лога: моноширинная, без переноса, с обрезкой. -->
    <Style x:Key="Style.LogText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Значок происхождения кадра traceback (мод / клиент / res_mods). -->
    <Style x:Key="Style.OriginBadge" TargetType="Border">
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
