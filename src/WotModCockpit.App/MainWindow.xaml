<controls:ChromeWindow x:Class="WotModCockpit.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:WotModCockpit.App.Converters"
        xmlns:views="clr-namespace:WotModCockpit.App.Views"
        xmlns:controls="clr-namespace:WotModCockpit.App.Controls"
        xmlns:models="clr-namespace:WotModCockpit.Core.Models;assembly=WotModCockpit.Core"
        Title="WoT Mod Cockpit"
        Icon="Resources/cockpit.ico"
        Height="860"
        Width="1440"
        MinHeight="520"
        MinWidth="900"
        WindowStartupLocation="CenterScreen">

    <controls:ChromeWindow.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBooleanConverter x:Key="InverseBool" />
        <conv:StringToVisibilityConverter x:Key="StrToVis" />
        <conv:CountToVisibilityConverter x:Key="CountToVis" />
        <conv:FileNameConverter x:Key="FileName" />

        <!-- Замечание проверки проекта. -->
        <DataTemplate x:Key="IssueTemplate" DataType="{x:Type models:ProjectValidation}">
            <StackPanel Orientation="Horizontal" Margin="0,1">
                <TextBlock Text="{Binding Code}"
                           FontFamily="{StaticResource Font.Mono}"
                           FontSize="10"
                           MinWidth="200"
                           Foreground="{StaticResource Brush.TextMuted}" />
                <TextBlock x:Name="Msg" Text="{Binding Message}" FontSize="11" />
                <TextBlock Text="{Binding Path}"
                           FontSize="10"
                           Margin="8,0,0,0"
                           Foreground="{StaticResource Brush.TextMuted}"
                           Visibility="{Binding Path, Converter={StaticResource StrToVis}}" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="Error">
                    <Setter TargetName="Msg" Property="Foreground" Value="{StaticResource Brush.DangerText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                    <Setter TargetName="Msg" Property="Foreground" Value="{StaticResource Brush.WarnText}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Строка вывода build.py. -->
        <DataTemplate x:Key="BuildLineTemplate" DataType="{x:Type models:BuildOutputLine}">
            <TextBlock x:Name="Line"
                       Text="{Binding Text}"
                       FontFamily="{StaticResource Font.Mono}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource Brush.Text}" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Stream}" Value="{x:Static models:BuildStreamKind.Stderr}">
                    <Setter TargetName="Line" Property="Foreground" Value="{StaticResource Log.Error}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Stream}" Value="{x:Static models:BuildStreamKind.Diagnostic}">
                    <Setter TargetName="Line" Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                    <Setter TargetName="Line" Property="FontStyle" Value="Italic" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </controls:ChromeWindow.Resources>

    <DockPanel>

        <!-- ==================== ПЕРЕКЛЮЧАТЕЛЬ ЭКРАНОВ ==================== -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource Brush.Panel}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,0,0,1"
                Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <!-- Экранов три, и они взаимоисключающие. Переключателем владеет этап 3
                         (Stage3.IsBuildScreen), потому что «экран сборки» теперь означает
                         «не браузер API И не рецепты», а двумя независимыми галочками это
                         не выражается. -->
                    <ToggleButton Style="{StaticResource Style.Chip}"
                                  Content="Сборка и лог"
                                  IsChecked="{Binding IsBuildChipChecked, Mode=TwoWay}"
                                  ToolTip="Шапка проекта, тулбар build.py, состояние деплоя и живой python.log" />
                    <ToggleButton Style="{StaticResource Style.Chip}"
                                  Content="Браузер API"
                                  IsChecked="{Binding IsApiScreen}"
                                  IsEnabled="{Binding HasApiBrowser}"
                                  ToolTip="Поиск по декомпилированным исходникам клиента: символы, события, сервисы, горячие точки" />
                    <ToggleButton Style="{StaticResource Style.Chip}"
                                  Content="Рецепты"
                                  IsChecked="{Binding Stage3.IsRecipesScreen, Mode=TwoWay}"
                                  IsEnabled="{Binding HasStage3}"
                                  ToolTip="Готовые куски кода на Python 2.7 под типовые задачи мода: логи, события, хоткеи, монкипатчи, настройки" />

                    <ToggleButton Style="{StaticResource Style.Chip}"
                                  Content="Настройки мода"
                                  IsChecked="{Binding IsSettingsScreen, Mode=TwoWay}"
                                  IsEnabled="{Binding HasSettingsDesigner}"
                                  ToolTip="Дизайнер окна настроек для ModsSettingsAPI: собрать форму мышью и получить рабочий код на Python 2.7" />

                    <ToggleButton Style="{StaticResource Style.Chip}"
                                  Content="Моды"
                                  IsChecked="{Binding IsModsScreen, Mode=TwoWay}"
                                  IsEnabled="{Binding HasMods}"
                                  ToolTip="Что установлено в игре: свои и чужие .mtmod, включение и выключение, установка собранной версии" />

                    <TextBlock Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource Style.Muted}"
                               Text="в браузере API ищутся события и сервисы клиента, которых загрузчик моду не отдаёт"
                               Visibility="{Binding IsApiScreen, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ToggleButton Style="{StaticResource Style.Chip}"
                                  IsChecked="{Binding Stage3.ShowProblems}"
                                  IsEnabled="{Binding HasStage3}"
                                  ToolTip="Панель Problems под лентой лога: находки статического анализа кода мода">
                        <TextBlock Text="{Binding Stage3.Problems.HeaderText}" />
                    </ToggleButton>

                    <Button Style="{StaticResource Style.SmallButton}"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            Content="Новый мод…"
                            Command="{Binding Stage3.NewProjectCommand}"
                            ToolTip="Создать проект мода из шаблона: свои id, имя, пакет, точка входа и тег лога" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <!-- Видимость экрана сборки завязана на IsBuildChipChecked, а не на Stage3.IsBuildScreen:
                 Stage3 не знает про экран «Моды», и без этой поправки панель сборки оставалась бы
                 Visible ПОД лаунчером. Фоном она невидима, но её кнопки остаются в порядке обхода
                 по Tab — а среди них «Удалить из игры», которая трогает каталог игры. Экран,
                 которого не видно, не должен принимать ни фокус, ни нажатие. -->
            <Grid Visibility="{Binding IsBuildChipChecked, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="120" />
                    <!-- Разделитель дока Problems: тот же приём, что у BuildSplitter. -->
                    <RowDefinition Height="Auto" />
                    <!-- Панель Problems: док под лентой, как в Visual Studio. Высота в пикселях,
                         чтобы её можно было тянуть сплиттером; свёрнутая панель получает 0
                         из code-behind (RowDefinition не входит в визуальное дерево и
                         DataContext окна через RelativeSource не видит). -->
                    <RowDefinition x:Name="ProblemsRow" Height="230" MinHeight="0" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ============================ 1. ШАПКА ============================ -->
                <Border Grid.Row="0" Style="{StaticResource Style.Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Игра. Путь — единственное поле переменной длины, поэтому именно он
                                 забирает звёздочку и обрезается; версия видна всегда. -->
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Style="{StaticResource Style.FieldLabel}" Text="ИГРА (только чтение)" />
                                <Grid Visibility="{Binding GameProblem, Converter={StaticResource StrToVis}, ConverterParameter=invert}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MaxWidth="420" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Style="{StaticResource Style.MonoValue}"
                                               Text="{Binding GameDir}"
                                               ToolTip="{Binding GameDir}" />
                                    <TextBlock Grid.Column="1"
                                               Style="{StaticResource Style.MonoValue}"
                                               Foreground="{StaticResource Brush.OkText}"
                                               ToolTip="Активная версия из paths.xml, а не самый большой каталог в mods\">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="  —  {0}">
                                                <Binding Path="GameVersion" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Grid>
                                <TextBlock Style="{StaticResource Style.FieldValue}"
                                           Foreground="{StaticResource Brush.WarnText}"
                                           Text="{Binding GameProblem}"
                                           Visibility="{Binding GameProblem, Converter={StaticResource StrToVis}}" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Style="{StaticResource Style.SmallButton}"
                                    Content="выбрать папку игры…"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,16,0"
                                    Command="{Binding BrowseGameCommand}" />

                            <!-- Проект -->
                            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                <TextBlock Style="{StaticResource Style.FieldLabel}" Text="ПРОЕКТ МОДА" />
                                <Grid Visibility="{Binding ProjectProblem, Converter={StaticResource StrToVis}, ConverterParameter=invert}">
                                    <Grid.ColumnDefinitions>
                                        <!-- Путь и id сжимаются с многоточием, версия видна всегда:
                                             именно её проверяют глазами перед установкой. -->
                                        <ColumnDefinition Width="Auto" MaxWidth="380" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Style="{StaticResource Style.MonoValue}"
                                               Text="{Binding ProjectDir}"
                                               ToolTip="{Binding ProjectDir}" />
                                    <TextBlock Grid.Column="1"
                                               Style="{StaticResource Style.MonoValue}"
                                               ToolTip="{Binding ModId}">
                                        <Run Text="  —  " Foreground="{StaticResource Brush.TextMuted}" />
                                        <Run Text="{Binding ModId, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Grid.Column="2"
                                               Style="{StaticResource Style.MonoValue}"
                                               Margin="6,0,0,0"
                                               Foreground="{StaticResource Brush.OkText}"
                                               Text="{Binding ModVersion}" />
                                </Grid>
                                <TextBlock Style="{StaticResource Style.Muted}"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding ModDisplayName}"
                                           Visibility="{Binding ModDisplayName, Converter={StaticResource StrToVis}}" />
                                <TextBlock Style="{StaticResource Style.FieldValue}"
                                           Foreground="{StaticResource Brush.WarnText}"
                                           Text="{Binding ProjectProblem}"
                                           Visibility="{Binding ProjectProblem, Converter={StaticResource StrToVis}}" />
                            </StackPanel>

                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button Style="{StaticResource Style.SmallButton}"
                                        Content="выбрать папку проекта…"
                                        Margin="0,0,6,0"
                                        Command="{Binding BrowseProjectCommand}" />
                                <Button Style="{StaticResource Style.SmallButton}"
                                        Content="перечитать"
                                        Command="{Binding ReloadProjectCommand}"
                                        ToolTip="Перечитать wotmod.json и meta.xml с диска" />
                            </StackPanel>
                        </Grid>

                        <!-- Замечания проверки проекта -->
                        <Border Margin="0,8,0,0"
                                Padding="8,5"
                                CornerRadius="3"
                                Background="{StaticResource Brush.WarnBg}"
                                BorderBrush="#FF5C5030"
                                BorderThickness="1"
                                Visibility="{Binding ProjectIssues.Count, Converter={StaticResource CountToVis}}">
                            <StackPanel>
                                <TextBlock Text="замечания по проекту:"
                                           FontSize="10"
                                           Margin="0,0,0,3"
                                           Foreground="{StaticResource Brush.TextMuted}" />
                                <ItemsControl ItemsSource="{Binding ProjectIssues}"
                                              ItemTemplate="{StaticResource IssueTemplate}" />

                                <!-- Единственное замечание, которое кокпит умеет снять сам:
                                     NO_WOTMOD_JSON. Пишет в каталог ПРОЕКТА, не игры, и только по нажатию. -->
                                <Button Style="{StaticResource Style.SmallButton}"
                                        Content="создать wotmod.json"
                                        HorizontalAlignment="Left"
                                        Margin="0,6,0,0"
                                        Command="{Binding CreateWotmodJsonCommand}"
                                        Visibility="{Binding WotmodJsonMissing, Converter={StaticResource BoolToVis}}"
                                        ToolTip="Записать дескриптор кокпита в &lt;проект&gt;\wotmod.json. src\meta.xml не трогается." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ============================ 2. ТУЛБАР ============================ -->
                <Border Grid.Row="1" Style="{StaticResource Style.Card}" Background="{StaticResource Brush.PanelAlt}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- Звёздочка, а не Auto: иначе на минимальной ширине окна (900) правый край
                                 тулбара просто обрезается вместе с чипами. Со звёздочкой WrapPanel
                                 переносит лишние кнопки на вторую строку. -->
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <WrapPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Style="{StaticResource Style.ToolButton}"
                                    Content="Собрать"
                                    Command="{Binding RunBuildCommand}"
                                    CommandParameter="{x:Static models:BuildAction.Build}"
                                    ToolTip="build.py без флагов действия: .mtmod в dist\. В игру НЕ пишет." />

                            <Button Style="{StaticResource Style.WriteButton}"
                                    Content="Собрать и установить"
                                    Command="{Binding RunBuildCommand}"
                                    CommandParameter="{x:Static models:BuildAction.BuildAndInstall}"
                                    ToolTip="build.py --install: копирует .mtmod в mods\&lt;версия&gt;\. ПИШЕТ В ИГРУ — спросит подтверждение." />

                            <Button Style="{StaticResource Style.WriteButton}"
                                    Content="Dev-раскладка"
                                    Command="{Binding RunBuildCommand}"
                                    CommandParameter="{x:Static models:BuildAction.DevDeploy}"
                                    ToolTip="build.py --dev: россыпь в res_mods\&lt;версия&gt;\. ПИШЕТ В ИГРУ и перекрывает .mtmod." />

                            <Button Style="{StaticResource Style.DangerButton}"
                                    Content="Удалить из игры"
                                    Command="{Binding RunBuildCommand}"
                                    CommandParameter="{x:Static models:BuildAction.Uninstall}"
                                    ToolTip="build.py --uninstall: убирает и .mtmod, и россыпь. ПИШЕТ В ИГРУ." />

                            <Button Style="{StaticResource Style.ToolButton}"
                                    Content="Листинг архива"
                                    Command="{Binding RunBuildCommand}"
                                    CommandParameter="{x:Static models:BuildAction.List}"
                                    ToolTip="build.py --list: содержимое собранного .mtmod. В игру НЕ пишет." />

                            <Separator Width="1" Margin="6,4" Background="{StaticResource Brush.Border}" />

                            <Button Style="{StaticResource Style.ToolButton}"
                                    Content="Открыть в VS Code"
                                    Command="{Binding OpenInEditorCommand}"
                                    IsEnabled="{Binding EditorAvailable}" />

                            <ToggleButton Style="{StaticResource Style.Chip}"
                                          Margin="6,0,0,0"
                                          VerticalAlignment="Center"
                                          Content="--clean"
                                          IsChecked="{Binding CleanBuild}"
                                          ToolTip="Очищать dist\ перед сборкой. ОСТОРОЖНО: вместе с dist\ уходит dev_manifest.json — список файлов Dev-раскладки, по которому «Удалить из игры» убирает россыпь из res_mods. Кокпит предупредит, если россыпь сейчас в игре." />

                            <ToggleButton Style="{StaticResource Style.Chip}"
                                          VerticalAlignment="Center"
                                          Content="панель сборки"
                                          IsChecked="{Binding ShowBuildPanel}" />
                        </WrapPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Style.Muted}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       Text="{Binding BusyText}"
                                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                            <ProgressBar Width="120"
                                         Height="6"
                                         IsIndeterminate="True"
                                         Margin="0,0,8,0"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource Style.SmallButton}"
                                    Content="отменить"
                                    Command="{Binding CancelBuildCommand}"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ======================= 3. СОСТОЯНИЕ ДЕПЛОЯ ======================= -->
                <Border Grid.Row="2" Style="{StaticResource Style.Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- mods\<ver> -->
                            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                <TextBlock Style="{StaticResource Style.FieldLabel}">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="mods\{0} (.mtmod)">
                                            <Binding Path="GameVersion" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding DeployInMods, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Style="{StaticResource Style.MonoValue}"
                                               Foreground="{StaticResource Brush.OkText}"
                                               Text="{Binding DeployMtmodPath, Converter={StaticResource FileName}}"
                                               ToolTip="{Binding DeployMtmodPath}" />
                                    <TextBlock Style="{StaticResource Style.Muted}"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="{Binding DeployMtmodInfo}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Style.Muted}"
                                           Text="не установлен"
                                           Visibility="{Binding DeployInMods, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                            </StackPanel>

                            <!-- res_mods\<ver> -->
                            <StackPanel Grid.Column="1" Margin="0,0,24,0">
                                <TextBlock Style="{StaticResource Style.FieldLabel}">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="res_mods\{0} (россыпь)">
                                            <Binding Path="GameVersion" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock Style="{StaticResource Style.FieldValue}"
                                           Foreground="{StaticResource Brush.WarnText}"
                                           Visibility="{Binding DeployInResMods, Converter={StaticResource BoolToVis}}"
                                           Text="{Binding DeployResModsCount, StringFormat='файлов: {0}'}" />
                                <TextBlock Style="{StaticResource Style.Muted}"
                                           Text="чисто"
                                           Visibility="{Binding DeployInResMods, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                            </StackPanel>

                            <!-- старые версии -->
                            <StackPanel Grid.Column="2"
                                        Margin="0,0,24,0"
                                        Visibility="{Binding DeployStaleCount, Converter={StaticResource CountToVis}}">
                                <TextBlock Style="{StaticResource Style.FieldLabel}" Text="ЛИШНИЕ .mtmod" />
                                <TextBlock Style="{StaticResource Style.FieldValue}"
                                           Foreground="{StaticResource Brush.WarnText}"
                                           Text="{Binding DeployStaleCount, StringFormat='старых версий рядом: {0}'}"
                                           ToolTip="Старые .mtmod того же мода — частая причина «правлю, а не меняется»" />
                            </StackPanel>

                            <TextBlock Grid.Column="3"
                                       Style="{StaticResource Style.Muted}"
                                       VerticalAlignment="Bottom"
                                       Text="{Binding DeploySummary}" />

                            <Button Grid.Column="4"
                                    Style="{StaticResource Style.SmallButton}"
                                    Content="обновить"
                                    VerticalAlignment="Bottom"
                                    Command="{Binding RefreshDeployCommand}" />
                        </Grid>

                        <!-- Главный капкан: россыпь перекрывает пакет -->
                        <Border Margin="0,8,0,0"
                                Padding="10,7"
                                CornerRadius="3"
                                Background="{StaticResource Brush.DangerBg}"
                                BorderBrush="{StaticResource Brush.Danger}"
                                BorderThickness="1"
                                Visibility="{Binding IsShadowed, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource Brush.DangerText}"
                                           FontWeight="Bold"
                                           FontSize="13"
                                           Text="МОД ЛЕЖИТ И В res_mods, И В .mtmod — ВЫ ПРАВИТЕ НЕ ТОТ ФАЙЛ" />
                                <TextBlock Foreground="{StaticResource Brush.DangerText}"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0"
                                           Text="В paths.xml строка ./res_mods/&lt;версия&gt; идёт ПЕРВОЙ, поэтому одноимённые файлы из россыпи молча перекрывают содержимое .mtmod. Игра грузит россыпь, а пересобранный пакет не читается. Уберите Dev-раскладку кнопкой «Удалить из игры» или продолжайте работать только через неё." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ==================== 4. ЛОГ + ВЫВОД СБОРКИ ==================== -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="360" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition x:Name="BuildColumn" Width="420" MinWidth="0" />
                    </Grid.ColumnDefinitions>

                    <views:LogView Grid.Column="0" />

                    <GridSplitter x:Name="BuildSplitter"
                                  Grid.Column="1"
                                  Width="4"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Visibility="{Binding ShowBuildPanel, Converter={StaticResource BoolToVis}}" />

                    <Border Grid.Column="2"
                            Background="{StaticResource Brush.Panel}"
                            Visibility="{Binding ShowBuildPanel, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="{StaticResource Brush.PanelAlt}"
                                    BorderBrush="{StaticResource Brush.Border}"
                                    BorderThickness="0,0,0,1"
                                    Padding="8,5">
                                <Grid>
                                    <TextBlock Text="вывод build.py" VerticalAlignment="Center" />
                                    <Button HorizontalAlignment="Right"
                                            Style="{StaticResource Style.SmallButton}"
                                            Content="копировать команду"
                                            Command="{Binding CopyCommandLineCommand}"
                                            ToolTip="{Binding LastCommandLine}" />
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1">
                                <ListBox ItemsSource="{Binding BuildOutput}"
                                         ItemTemplate="{StaticResource BuildLineTemplate}"
                                         HorizontalContentAlignment="Stretch"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         VirtualizingPanel.ScrollUnit="Pixel"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

                                <TextBlock Style="{StaticResource Style.EmptyState}"
                                           FontSize="12"
                                           Text="Сборка ещё не запускалась.&#10;&#10;Кнопка «Собрать» вызовет build.py и покажет его вывод здесь.&#10;В каталог игры при этом ничего не пишется."
                                           Visibility="{Binding BuildOutput.Count, Converter={StaticResource CountToVis}, ConverterParameter=invert}" />
                            </Grid>

                            <TextBlock Grid.Row="2"
                                       Style="{StaticResource Style.Muted}"
                                       Margin="8,4"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding LastCommandLine}"
                                       ToolTip="{Binding LastCommandLine}" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- ==================== 5. ПАНЕЛЬ PROBLEMS ==================== -->
                <GridSplitter x:Name="ProblemsSplitter"
                              Grid.Row="4"
                              Height="4"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext"
                              ResizeDirection="Rows"
                              Visibility="{Binding Stage3.ShowProblems, Converter={StaticResource BoolToVis}}" />

                <views:ProblemsView Grid.Row="5"
                                    DataContext="{Binding Stage3.Problems}"
                                    Visibility="{Binding DataContext.Stage3.ShowProblems, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />

                <!-- ======================= 6. СТРОКА СОСТОЯНИЯ ======================= -->
                <Border Grid.Row="6"
                        Background="{StaticResource Brush.Panel}"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="0,1,0,0"
                        Padding="10,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource Style.Muted}"
                                   Text="{Binding PythonInfo}"
                                   ToolTip="Python 3.x, которым запускается build.py" />

                        <TextBlock Grid.Column="1"
                                   Style="{StaticResource Style.Muted}"
                                   Margin="16,0"
                                   Text="{Binding TailerStatus}"
                                   ToolTip="Состояние слежения за python.log" />

                        <TextBlock Grid.Column="2"
                                   Style="{StaticResource Style.Muted}"
                                   HorizontalAlignment="Right"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding StatusMessage}"
                                   ToolTip="{Binding StatusMessage}" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Второй экран. Лежит поверх первого в той же ячейке: переключение —
                 это смена Visibility, а не пересоздание дерева, поэтому состояние
                 браузера (поиск, выбранный символ, прокрутка кода) переживает уход
                 на экран сборки и обратно. -->
            <views:ApiBrowserView DataContext="{Binding ApiBrowser}"
                                  Visibility="{Binding DataContext.IsApiScreen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />

            <!-- Третий экран этапа 3. Лежит в той же ячейке, что и два предыдущих:
                 переключение — смена Visibility, поэтому выбранный рецепт, введённые
                 параметры и прокрутка кода переживают уход на другой экран. -->
            <views:RecipesView DataContext="{Binding Stage3.Recipes}"
                               Visibility="{Binding DataContext.Stage3.IsRecipesScreen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />

            <!-- Четвёртый экран, этап 4: дизайнер настроек ModsSettingsAPI. Живёт в той же
                 ячейке, что и три предыдущих, — собранная форма переживает уход на другой
                 экран и возврат. -->
            <views:SettingsDesignerView DataContext="{Binding SettingsDesigner}"
                                        Visibility="{Binding DataContext.IsSettingsScreen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />

            <!-- Пятый экран: лаунчер модов. Та же ячейка, что и у остальных, — выбранный мод,
                 фильтр и прокрутка переживают уход на другой экран и возврат. Каталог игры
                 читается лениво, при первом показе экрана: на старте приложения не делается
                 ничего, даже чтения. -->
            <views:ModsView DataContext="{Binding Mods}"
                            Visibility="{Binding DataContext.IsModsScreen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
        </Grid>
    </DockPanel>
</controls:ChromeWindow>
