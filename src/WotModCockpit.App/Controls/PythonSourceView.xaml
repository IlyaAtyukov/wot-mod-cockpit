<UserControl x:Class="WotModCockpit.App.Controls.PythonSourceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalon="clr-namespace:ICSharpCode.AvalonEdit;assembly=ICSharpCode.AvalonEdit"
             Background="{StaticResource Brush.Window}">

    <Grid>
        <!-- Сам просмотрщик. IsReadOnly намеренно: кокпит не редактор, правка остаётся
             за VS Code (кнопка в заголовке карточки символа). -->
        <avalon:TextEditor x:Name="Editor"
                           IsReadOnly="True"
                           ShowLineNumbers="True"
                           WordWrap="False"
                           FontFamily="{StaticResource Font.Mono}"
                           FontSize="12"
                           Background="#FF17171A"
                           Foreground="{StaticResource Brush.Text}"
                           LineNumbersForeground="#FF5A5A63"
                           HorizontalScrollBarVisibility="Auto"
                           VerticalScrollBarVisibility="Auto" />

        <!-- Пустое состояние и сообщения об отказе. Перекрывает редактор целиком,
             чтобы под ним не просвечивал текст прошлого файла. -->
        <Border x:Name="Overlay"
                Background="#FF17171A"
                Visibility="Collapsed">
            <TextBlock x:Name="OverlayText"
                       Style="{StaticResource Style.EmptyState}"
                       Text="Символ не выбран." />
        </Border>
    </Grid>
</UserControl>
