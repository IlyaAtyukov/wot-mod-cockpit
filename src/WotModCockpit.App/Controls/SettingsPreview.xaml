<UserControl x:Class="WotModCockpit.App.Controls.SettingsPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WotModCockpit.App.Controls"
             xmlns:conv="clr-namespace:WotModCockpit.App.Converters"
             Background="{StaticResource Brush.Window}">

    <!--
        СХЕМА окна настроек «Мира танков», а не его снимок.

        Пиксель-в-пиксель здесь невозможен в принципе: modsSettingsWindow.swf содержит
        десять тегов ImportAssets2 и берёт всю графику и ШРИФТЫ из библиотек клиента
        (gfxfontlib.swf, assets.swf, guiControlsLobby.swf и ещё семи). Своего в файле —
        22 спрайта и 20 картинок. Значит настоящие высоты строк и переносы подписей
        живут в клиенте, а не в шаблоне.

        Что здесь ТОЧНО, потому что вытащено из байткода окна:
            ширина блока мода            900  (Constants.MOD_COMPONENT_WIDTH)
            отступ слева                  20  (MOD_PADDING_LEFT)
            вторая колонка при x=450 -> на колонку ровно 430
            промежуток между контролами   10  (COMPONENT_MARGIN_BOTTOM)
            отступ контрола от подписи    20  (COMPONENT_HEADER_MARGIN)
            однострочные контролы при    315  (подпись слева, контрол справа)
            распорка Empty                20  (EMPTY_COMPONENT_HEIGHT)
            ширина RangeSlider           240
            прокрутка списка после         9 пунктов (SCROLL_ITEM_LIMIT)
    -->

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:LeftMarginConverter x:Key="ThumbMargin" />

        <controls:SettingsTemplateSelector x:Key="PreviewSelector" Prefix="Preview." />

        <!-- Значок подсказки: в окне это кружок «i» рядом с подписью. -->
        <Style x:Key="Preview.InfoIcon" TargetType="Border">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Margin" Value="5,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="#FF33414D" />
            <Setter Property="BorderBrush" Value="#FF4A5D6D" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="Preview.Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="Preview.Value" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- Рамка контрола в окне: тёмное поле со светлой границей. -->
        <Style x:Key="Preview.Box" TargetType="Border">
            <Setter Property="Background" Value="#FF17171A" />
            <Setter Property="BorderBrush" Value="#FF4A4A53" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Height" Value="22" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <!-- Подпись + значок подсказки. Используется всеми шаблонами. -->
        <DataTemplate x:Key="Preview.Header">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding PreviewText}" Style="{StaticResource Preview.Caption}" />
                <Border Style="{StaticResource Preview.InfoIcon}"
                        ToolTip="{Binding Tooltip}"
                        Visibility="{Binding HasTooltip, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="i"
                               FontSize="9"
                               FontStyle="Italic"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#FF9FC4DF" />
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- ================================================== шаблоны 11 типов -->

        <DataTemplate x:Key="Preview.Label">
            <StackPanel>
                <TextBlock Text="{Binding PreviewText}"
                           FontSize="13"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource Brush.Text}" />
                <TextBlock Text="в окне у заголовка ширина 800 px — длинный текст залезет на соседнюю колонку"
                           FontSize="9"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource Brush.TextMuted}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="Preview.Empty">
            <Border Height="20"
                    Background="#11FFFFFF"
                    BorderBrush="#FF3A3A41"
                    BorderThickness="1">
                <TextBlock Text="пустая строка · 20 px · в игре не видна"
                           FontSize="9"
                           FontStyle="Italic"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource Brush.TextMuted}" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="Preview.CheckBox">
            <StackPanel Orientation="Horizontal">
                <Border x:Name="Box"
                        Width="14"
                        Height="14"
                        Margin="0,0,7,0"
                        VerticalAlignment="Center"
                        Background="#FF17171A"
                        BorderBrush="#FF4A4A53"
                        BorderThickness="1"
                        CornerRadius="2">
                    <Path x:Name="Tick"
                          Data="M0,3 L2.5,6 L7,0"
                          Stroke="#FF63C79E"
                          StrokeThickness="2"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Visibility="Collapsed" />
                </Border>
                <TextBlock Text="{Binding PreviewText}" Style="{StaticResource Preview.Caption}" />
                <Border Style="{StaticResource Preview.InfoIcon}"
                        ToolTip="{Binding Tooltip}"
                        Visibility="{Binding HasTooltip, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="i" FontSize="9" FontStyle="Italic"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="#FF9FC4DF" />
                </Border>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding BoolValue}" Value="True">
                    <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Box" Property="BorderBrush" Value="#FF63C79E" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="Preview.RadioButtonGroup">
            <StackPanel>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Preview.Header}" />
                <ItemsControl ItemsSource="{Binding Options}" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Border x:Name="Dot"
                                        Width="12"
                                        Height="12"
                                        Margin="0,0,7,0"
                                        CornerRadius="6"
                                        VerticalAlignment="Center"
                                        Background="#FF17171A"
                                        BorderBrush="#FF4A4A53"
                                        BorderThickness="1" />
                                <TextBlock Text="{Binding Label}"
                                           FontSize="11"
                                           Foreground="{StaticResource Brush.TextMuted}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelectedValue}" Value="True">
                                    <Setter TargetName="Dot" Property="Background" Value="{StaticResource Brush.AccentHover}" />
                                    <Setter TargetName="Dot" Property="BorderBrush" Value="{StaticResource Brush.AccentHover}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="Preview.Dropdown">
            <StackPanel>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Preview.Header}" />
                <Border Style="{StaticResource Preview.Box}"
                        Width="{Binding PreviewWidth}"
                        Height="24"
                        Margin="0,4,0,0">
                    <Grid>
                        <TextBlock Text="{Binding PreviewValueText}"
                                   Margin="7,0,20,0"
                                   Style="{StaticResource Preview.Value}" />
                        <Path Data="M0,0 L8,0 L4,5 Z"
                              Fill="{StaticResource Brush.TextMuted}"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Margin="0,0,7,0" />
                    </Grid>
                </Border>
                <TextBlock Text="в окне появится полоса прокрутки: пунктов больше девяти"
                           FontSize="9"
                           Margin="0,2,0,0"
                           Foreground="{StaticResource Brush.WarnText}"
                           Visibility="{Binding ScrollsInGame, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="Preview.Slider">
            <StackPanel>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Preview.Header}" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Grid Width="{Binding PreviewWidth}" Height="14" VerticalAlignment="Center">
                        <Border Height="4"
                                VerticalAlignment="Center"
                                Background="#FF17171A"
                                BorderBrush="#FF4A4A53"
                                BorderThickness="1"
                                CornerRadius="2" />
                        <Border Height="4"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Width="{Binding PreviewFillWidth}"
                                Background="{StaticResource Brush.Accent}"
                                CornerRadius="2" />
                        <Border Width="8"
                                Height="14"
                                HorizontalAlignment="Left"
                                Background="#FFB8C4CC"
                                CornerRadius="2"
                                Margin="{Binding PreviewFillWidth, Converter={StaticResource ThumbMargin}}" />
                    </Grid>
                    <TextBlock Text="{Binding PreviewValueText}"
                               Margin="10,0,0,0"
                               Style="{StaticResource Preview.Value}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="Preview.TextInput">
            <StackPanel>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Preview.Header}" />
                <Border Style="{StaticResource Preview.Box}"
                        Width="{Binding PreviewWidth}"
                        Height="24"
                        Margin="0,4,0,0">
                    <TextBlock Text="{Binding PreviewValueText}"
                               Margin="7,0"
                               Style="{StaticResource Preview.Value}" />
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- Однострочные контролы: подпись слева, контрол в окне при x=315. -->
        <DataTemplate x:Key="Preview.NumericStepper">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="295" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ContentPresenter Grid.Column="0" Content="{Binding}" ContentTemplate="{StaticResource Preview.Header}" />
                <Border Grid.Column="1" Style="{StaticResource Preview.Box}" Width="90">
                    <Grid>
                        <TextBlock Text="{Binding PreviewValueText}" Margin="7,0,18,0" Style="{StaticResource Preview.Value}" />
                        <StackPanel HorizontalAlignment="Right" Margin="0,0,4,0" VerticalAlignment="Center">
                            <Path Data="M0,4 L8,4 L4,0 Z" Fill="{StaticResource Brush.TextMuted}" Margin="0,0,0,2" />
                            <Path Data="M0,0 L8,0 L4,4 Z" Fill="{StaticResource Brush.TextMuted}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="Preview.HotKey">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="295" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ContentPresenter Grid.Column="0" Content="{Binding}" ContentTemplate="{StaticResource Preview.Header}" />
                <Border Grid.Column="1" Style="{StaticResource Preview.Box}" Width="115">
                    <TextBlock Text="{Binding PreviewValueText}"
                               HorizontalAlignment="Center"
                               Style="{StaticResource Preview.Value}" />
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="Preview.ColorChoice">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="295" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ContentPresenter Grid.Column="0" Content="{Binding}" ContentTemplate="{StaticResource Preview.Header}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Border Width="34"
                            Height="20"
                            Background="{Binding ColorBrush}"
                            BorderBrush="#FF4A4A53"
                            BorderThickness="1"
                            CornerRadius="2" />
                    <TextBlock Text="{Binding PreviewValueText}"
                               Margin="7,0,0,0"
                               FontFamily="{StaticResource Font.Mono}"
                               Style="{StaticResource Preview.Value}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="Preview.RangeSlider">
            <StackPanel>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Preview.Header}" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Grid Width="240" Height="14" VerticalAlignment="Center">
                        <Border Height="4"
                                VerticalAlignment="Center"
                                Background="#FF17171A"
                                BorderBrush="#FF4A4A53"
                                BorderThickness="1"
                                CornerRadius="2" />
                        <Border Height="4"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Width="{Binding RangeFillWidth}"
                                Margin="{Binding RangeFillOffset, Converter={StaticResource ThumbMargin}}"
                                Background="{StaticResource Brush.Accent}"
                                CornerRadius="2" />
                    </Grid>
                    <TextBlock Text="{Binding PreviewValueText}"
                               Margin="10,0,0,0"
                               Style="{StaticResource Preview.Value}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Тумблер мода. Он гасит контролы ТОЛЬКО визуально (alpha 0.5,
             mouseEnabled=false): логику выключения мод обязан реализовать сам. -->
        <DataTemplate x:Key="Preview.EnabledSwitch">
            <Border x:Name="Track"
                    Width="30"
                    Height="16"
                    CornerRadius="8"
                    Margin="0,0,10,0"
                    Background="#FF17171A"
                    BorderBrush="#FF4A4A53"
                    BorderThickness="1"
                    ToolTip="тумблер мода: он есть, только пока в шаблоне есть ключ enabled">
                <Ellipse x:Name="Knob"
                         Width="10"
                         Height="10"
                         HorizontalAlignment="Left"
                         Margin="2,0,0,0"
                         Fill="{StaticResource Brush.TextMuted}" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding EnabledDefault}" Value="True">
                    <Setter TargetName="Track" Property="Background" Value="{StaticResource Brush.Accent}" />
                    <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Brush.AccentHover}" />
                    <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                    <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0" />
                    <Setter TargetName="Knob" Property="Fill" Value="#FFFFFFFF" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="Preview.Default">
            <TextBlock Text="{Binding PreviewText}" Style="{StaticResource Preview.Caption}" />
        </DataTemplate>

        <!-- Контейнер строки колонки: выделение, пометка ошибки, отступ 10 px как в окне. -->
        <Style x:Key="Preview.Item" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="2"
                                Padding="4,3"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#18FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF243141" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.AccentHover}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Danger}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer x:Name="Scroller"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      Padding="10">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding FitPreview}" Value="True">
                            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>

            <!-- Viewbox нужен ровно для одного: показать блок шириной 900 px в панели,
                 которая может быть уже. StretchDirection=DownOnly — увеличивать схему
                 нельзя, иначе она начнёт врать про размеры. -->
            <Viewbox HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     StretchDirection="DownOnly">
                <Viewbox.Style>
                    <Style TargetType="Viewbox">
                        <Setter Property="Stretch" Value="None" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FitPreview}" Value="True">
                                <Setter Property="Stretch" Value="Uniform" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Viewbox.Style>

                <Border Width="900"
                        Background="{StaticResource Brush.Panel}"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="1"
                        Padding="20">
                    <StackPanel>
                        <!-- Шапка блока мода: тумблер есть, только если в шаблоне есть ключ enabled. -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <ContentControl Content="{Binding}"
                                            ContentTemplate="{StaticResource Preview.EnabledSwitch}"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding HasEnabled, Converter={StaticResource BoolToVis}}" />

                            <TextBlock Text="{Binding ModDisplayName}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.Text}" />
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="430" />
                                <ColumnDefinition Width="430" />
                            </Grid.ColumnDefinitions>

                            <ListBox x:Name="Column1List"
                                     Grid.Column="0"
                                     AllowDrop="True"
                                     MinHeight="120"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ItemsSource="{Binding Column1}"
                                     SelectedItem="{Binding Selected, Mode=OneWay}"
                                     ItemContainerStyle="{StaticResource Preview.Item}"
                                     ItemTemplateSelector="{StaticResource PreviewSelector}"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     SelectionChanged="OnColumnSelectionChanged"
                                     PreviewMouseLeftButtonDown="OnColumnMouseDown"
                                     PreviewMouseMove="OnColumnMouseMove"
                                     DragOver="OnColumnDragOver"
                                     DragLeave="OnColumnDragLeave"
                                     Drop="OnColumnDrop" />

                            <ListBox x:Name="Column2List"
                                     Grid.Column="1"
                                     AllowDrop="True"
                                     MinHeight="120"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ItemsSource="{Binding Column2}"
                                     SelectedItem="{Binding Selected, Mode=OneWay}"
                                     ItemContainerStyle="{StaticResource Preview.Item}"
                                     ItemTemplateSelector="{StaticResource PreviewSelector}"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     SelectionChanged="OnColumnSelectionChanged"
                                     PreviewMouseLeftButtonDown="OnColumnMouseDown"
                                     PreviewMouseMove="OnColumnMouseMove"
                                     DragOver="OnColumnDragOver"
                                     DragLeave="OnColumnDragLeave"
                                     Drop="OnColumnDrop" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Viewbox>
        </ScrollViewer>
    </Grid>
</UserControl>
