# Сборка .NET
bin/
obj/
artifacts/
TestResults/

# IDE и личные настройки
.vs/
.idea/
*.user
*.suo
*.DotSettings.user

# Python: кэш байткода (tools/*.py, проверки синтаксиса в тестах)
__pycache__/
*.py[cod]

# Рабочие каталоги, как у шаблона мода: дампы клиента, корпуса, скачанные инструменты
.scratch/
.tools/
node_modules/

# Собранные моды и сетапы, если их собрали прямо в корне репозитория. Только корень:
# фикстуры тестов с такими именами глубже по дереву игнорироваться не должны.
/dist/
/*.mtmod

# Локальные стенды и замеры — в репозиторий не входят
.bench/

# Локальные настройки и рабочие копии Claude Code
.claude/

# Личный стоп-список слов для снимков документации (см. docs/testing.md)
.screenshot-denylist.txt
