# Только кодировка, отступы и концы строк — правил стиля и анализаторов здесь нет
# намеренно: сборка не должна получить ни одного нового предупреждения.
# Концы строк согласованы с .gitattributes.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4

[*.{csproj,props,targets,manifest}]
indent_size = 2

[*.sln]
charset = utf-8-bom
end_of_line = crlf
indent_style = tab

[*.{cmd,bat,ps1}]
end_of_line = crlf
